{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "costs",
  "displayName": "Costs & Headcount",
  "displayOption": "FitToPage",
  "width": 1600,
  "height": 900,
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'canvas.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "canvas.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#E9E8E3'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "filterConfig": {
    "filters": [
      {
        "name": "pf_operating",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "P&L Line"
              }
            },
            "Property": "Is Operating"
          }
        },
        "type": "Categorical",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "t",
              "Entity": "P&L Line",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "t"
                          }
                        },
                        "Property": "Is Operating"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "true"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        },
        "isLockedInViewMode": true
      }
    ]
  }
}
