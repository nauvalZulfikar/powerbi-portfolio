{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "account",
  "displayName": "Account detail",
  "displayOption": "FitToPage",
  "width": 1600,
  "height": 900,
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'canvas.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "canvas.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#E9E8E3'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "filterConfig": {
    "filters": [
      {
        "name": "dt_line",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "P&L Line"
              }
            },
            "Property": "Line"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      }
    ]
  },
  "pageBinding": {
    "name": "dt_account",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "dt_line_param",
        "boundFilter": "dt_line",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "P&L Line"
              }
            },
            "Property": "Line"
          }
        }
      }
    ]
  },
  "type": "Drillthrough",
  "visibility": "HiddenInViewMode"
}
