	partition 'Line Account' = m
		mode: import
		source =
				let
				    Data = if SourceMode = "Lakehouse"
				        then Sql.Database(SqlEndpoint, LakehouseDb){[Schema = "dbo", Item = "bridge_line_account"]}[Data]
				        else Parquet.Document(File.Contents(DataFolder & "bridge_line_account.parquet")),
				    #"Choose columns" = Table.SelectColumns(Data, {"line_id", "account_key"}),
				    Typed = Table.TransformColumnTypes(#"Choose columns", {{"line_id", type text}, {"account_key", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
