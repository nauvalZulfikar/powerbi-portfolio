	partition 'GL Journal Agg' = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlEndpoint, LakehouseDb),
				    Data = Source{[Schema = "dbo", Item = "gl_journal"]}[Data],
				    Grouped = Table.Group(Data, {"period", "entity_key", "department_key", "account_key"}, {
				        {"amount_usd", each List.Sum([amount_usd]), type number},
				        {"lines", each Table.RowCount(_), Int64.Type}}),
				    Typed = Table.TransformColumnTypes(Grouped, {{"period", type date}, {"entity_key", Int64.Type}, {"department_key", Int64.Type}, {"account_key", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
