{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "name": "bm_view_chart",
  "displayName": "View: chart",
  "options": {
    "applyOnlyToTargetVisuals": true,
    "targetVisualNames": [
      "line_cumulative",
      "table_monthly"
    ],
    "suppressData": true,
    "suppressActiveSection": true
  },
  "explorationState": {
    "version": "1.3",
    "activeSection": "overview",
    "sections": {
      "overview": {
        "visualContainers": {
          "line_cumulative": {
            "singleVisual": {
              "visualType": "lineChart",
              "objects": {}
            }
          },
          "table_monthly": {
            "singleVisual": {
              "visualType": "tableEx",
              "objects": {},
              "display": {
                "mode": "hidden"
              }
            }
          }
        }
      }
    }
  }
}
