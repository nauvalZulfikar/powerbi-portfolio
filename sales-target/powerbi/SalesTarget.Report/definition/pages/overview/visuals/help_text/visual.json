          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read the status",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▲ On target — attainment 100% or more (green).",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#1B7F4B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "● At risk — 90% to 99% (amber).",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#A35F00"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▼ Behind — below 90% (red).",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#B42318"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Attainment = net sales ÷ target. The target is the rep's quota up to the last sale date, times 1 + the stretch you pick. Tables spell the status out, so colour is never the only cue.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
