          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What Power Query does with the three branch formats",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "North America sends a workbook per year with a sheet per month, a title block, a total row and the odd pasted duplicate sheet. Europe sends a workbook per quarter in German number and date formats, with reps as \"LASTNAME, First\". Pacific sends a system export with order and line in one cell, Excel serial dates and Windows logins.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "One reader function per format maps all three to one schema. Text numbers are converted, reps resolve through an alias list, lines sent twice are kept once, and every row that fails a rule is counted here with its reason instead of being dropped silently.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sales managers cannot see this page's data: object-level security hides the Cleaning Log.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              }
            ]
          }
