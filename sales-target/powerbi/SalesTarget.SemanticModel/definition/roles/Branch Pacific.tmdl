role 'Branch Pacific'
	modelPermission: read

	tablePermission Reps = LOOKUPVALUE ( Territories[Branch], Territories[Territory Key], Reps[Territory Key] ) = "PAC"


	tablePermission Territories = Territories[Branch] = "PAC"


	tablePermission 'Cleaning Log'
		metadataPermission: none

	tablePermission 'Reseller Cohort'
		metadataPermission: none

	tablePermission 'RFM Transition'
		metadataPermission: none

	tablePermission 'Subcategory Pairs'
		metadataPermission: none
