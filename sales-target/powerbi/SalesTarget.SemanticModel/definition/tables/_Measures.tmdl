	/// Status with a symbol, so it reads without colour (▲ on target, ● at risk, ▼ behind).
	measure 'Status Label' = SWITCH ( [Status], "On target", "▲ On target", "At risk", "● At risk", "Behind", "▼ Behind" )
		displayFolder: Target
		lineageTag: 306343b0-bb57-51c1-b622-0afe092d5773

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// The at-risk threshold: 90% of target. Band for the bullet chart.
	measure 'Target at 90%' = [Target] * 0.9
		displayFolder: Target
		lineageTag: f89766ac-35ca-5186-9d85-ca59462a24c5

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
