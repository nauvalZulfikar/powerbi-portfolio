				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Average days from order to shipment, per order line.
	measure 'Avg Days to Ship' = AVERAGEX ( Sales, DATEDIFF ( Sales[Order Date], Sales[Ship Date], DAY ) )
		formatString: #,0.0
		displayFolder: Sales
		lineageTag: e85eb134-a6a0-5b1e-9ac1-dc4c1762601b

	/// Resellers with at least one sale in the current filter (the Sales table as a CALCULATE filter).
	measure 'Active Resellers' = CALCULATE ( COUNTROWS ( Resellers ), Sales )
		formatString: #,0
		displayFolder: Sales
		lineageTag: e33640f1-dd67-5098-b241-0b24868cc902

	/// Share of the total the visual shows: ALLSELECTED keeps the slicers and drops the visual's own rows, so it works on whichever dimension Analyze By puts on the axis.
	measure 'Share of Visible Total' = DIVIDE ( [Net Sales], CALCULATE ( [Net Sales], ALLSELECTED () ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Sales
		lineageTag: 865bbedf-0f7c-5d2e-a3d0-0a429eed563c

	/// Rolling 12 months to the last date in the filter (DATESINPERIOD).
	measure 'Sales R12M' = CALCULATE ( [Net Sales], DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -12, MONTH ) )
		displayFolder: Sales
		lineageTag: 6b243b78-bde7-5c5a-a04f-ce7b5d4d044d

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Average of this and the two previous months on the axis (WINDOW -2 REL to 0 REL). A model measure rather than a visual calculation, so Time & Fiscal and Rep detail share it.
	measure 'Sales 3M Avg' =
			AVERAGEX (
			    WINDOW ( -2, REL, 0, REL, ALLSELECTED ( 'Date'[Year Month] ), ORDERBY ( 'Date'[Year Month] ) ),
			    [Net Sales] )
		displayFolder: Sales
		lineageTag: 90ac3414-3fa5-5e13-88be-a9886a0b8327

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
