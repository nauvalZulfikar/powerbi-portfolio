table _Measures
	lineageTag: 6301deb1-86e5-53cc-8fa1-70b9cffc3388

	/// Net line amount of clean order lines.
	measure 'Net Sales' = SUM ( Sales[Amount] )
		displayFolder: Sales
		lineageTag: 8cef3a97-5f01-5d02-892b-bf0c5c509e89

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Distinct order numbers.
	measure Orders = DISTINCTCOUNT ( Sales[Order Number] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: ab690115-c0ba-5107-b2c4-f53bdee76b98

	/// Units sold.
	measure Units = SUM ( Sales[Quantity] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 0d89f2a2-5cd2-517f-97f3-3c346b6e971c

	/// Sales per order.
	measure 'Avg Order Value' = DIVIDE ( [Net Sales], [Orders] )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Sales
		lineageTag: ed702283-d507-58f5-8284-e36f34ab79d7

	/// Sales a year earlier on the Gregorian calendar (UDF Sales.PriorYear).
	measure 'Sales PY' = Sales.PriorYear ( [Net Sales], 'Gregorian' )
		displayFolder: Sales
		lineageTag: ef72e660-c676-5854-9f41-17d983329b97

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Change against the same period a year earlier.
	measure 'Sales YoY %' = DIVIDE ( [Net Sales] - [Sales PY], [Sales PY] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Sales
		lineageTag: eee9ddc7-a4c9-52d1-81af-7d31a2dea030

	/// Share of all reps' sales in the current filter (UDF Sales.ShareOf).
	measure 'Sales Share' = Sales.ShareOf ( [Net Sales], Reps )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Sales
		lineageTag: 7c054bdb-2f47-5999-a0dd-4f169bab6cc3

	/// Date of the latest order in the data.
	measure 'Last Sale Date' = CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS () )
		formatString: dd mmm yyyy
		displayFolder: Sales
		lineageTag: 975757b9-0c23-5704-bd4b-e0a407d1ce58

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Net sales dated by ship date instead of order date: activates the inactive Sales[Ship Date] relationship.
	measure 'Net Sales by Ship Date' = CALCULATE ( [Net Sales], USERELATIONSHIP ( Sales[Ship Date], 'Date'[Date] ) )
		displayFolder: Sales
		lineageTag: 6318fd89-e44b-56f3-bb99-77cb970ce104

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
