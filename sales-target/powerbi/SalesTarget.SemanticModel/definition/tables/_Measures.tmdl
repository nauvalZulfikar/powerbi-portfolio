	/// Running total from the first month of each fiscal year (WINDOW 1 ABS to 0 REL, PARTITIONBY fiscal year).
	measure 'Sales Running FY' =
			SUMX (
			    WINDOW ( 1, ABS, 0, REL,
			        ALLSELECTED ( 'Date'[Fiscal Year Number], 'Date'[Year Month] ),
			        ORDERBY ( 'Date'[Year Month] ), KEEP, PARTITIONBY ( 'Date'[Fiscal Year Number] ) ),
			    [Net Sales] )
		displayFolder: Fiscal
		lineageTag: a9cbc7d8-f579-532f-85fa-85995dd6adfc

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Share of net sales from this product and every product that sells more (Pareto line).
	measure 'Product Cum Share' =
			VAR _s = [Net Sales]
			VAR _t = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( Products[Product Code] ), "@s", [Net Sales] ), ALLSELECTED ( Products ) )
			RETURN IF ( NOT ISBLANK ( _s ), DIVIDE ( SUMX ( FILTER ( _t, [@s] >= _s ), [@s] ), SUMX ( _t, [@s] ) ) )
		formatString: 0%
		displayFolder: Pareto & ABC
		lineageTag: 9316ec80-1a9f-5c99-818c-2ccdce4e58f4

	/// Share of the products sold that together make 80% of net sales.
	measure 'Product Share for 80% of Sales' =
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( Products[Product Code] ), "@s", [Net Sales] ), NOT ISBLANK ( [@s] ) )
			VAR _total = SUMX ( _t, [@s] )
			VAR _needed = COUNTROWS ( FILTER ( _t, VAR _v = [@s] RETURN SUMX ( FILTER ( _t, [@s] > _v ), [@s] ) < 0.8 * _total ) )
			RETURN DIVIDE ( _needed, COUNTROWS ( _t ) )
		formatString: 0%
		displayFolder: Pareto & ABC
		lineageTag: aedef2b7-afcf-5bb6-880b-be0c2060b59c

	/// Title of the Pareto chart: the 80/20 split for the current selection.
	measure 'Pareto Text' = "Pareto: " & FORMAT ( [Product Share for 80% of Sales], "0%" ) & " of the products sold make 80% of net sales"
		displayFolder: Pareto & ABC
		lineageTag: 459f3702-a414-5d15-9e95-59cc656b86f3

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Share of net sales from this reseller and every reseller that buys more.
	measure 'Reseller Cum Share' =
			VAR _s = [Net Sales]
			VAR _t = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( Resellers[Reseller Code] ), "@s", [Net Sales] ), ALLSELECTED ( Resellers ) )
			RETURN IF ( NOT ISBLANK ( _s ), DIVIDE ( SUMX ( FILTER ( _t, [@s] >= _s ), [@s] ), SUMX ( _t, [@s] ) ) )
		formatString: 0%
		displayFolder: Pareto & ABC
		lineageTag: 1b7bb3f3-0f65-53a9-8694-b2b1e4bbbdbd

	/// A: resellers that make the first 70% of net sales, B: the next 20%, C: the last 10%. Follows the slicers.
	measure 'Reseller ABC Class' =
			VAR _s = [Net Sales]
			VAR _t = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( Resellers[Reseller Code] ), "@s", [Net Sales] ), ALLSELECTED ( Resellers ) )
			VAR _before = COALESCE ( DIVIDE ( SUMX ( FILTER ( _t, [@s] > _s ), [@s] ), SUMX ( _t, [@s] ) ), 0 )
			RETURN IF ( NOT ISBLANK ( _s ),
			    MAXX ( FILTER ( ALL ( 'ABC Class' ), _before >= 'ABC Class'[Share From] && _before < 'ABC Class'[Share To] ),
			        'ABC Class'[Class] ) )
		displayFolder: Pareto & ABC
		lineageTag: 94035cc2-c13b-5688-8d6a-c9a198e9d7c1

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Net sales of the resellers in the ABC classes picked in the slicer.
	measure 'Sales in Class' = SUMX ( FILTER ( VALUES ( Resellers[Reseller Code] ), [Reseller ABC Class] IN VALUES ( 'ABC Class'[Class] ) ), [Net Sales] )
		displayFolder: Pareto & ABC
		lineageTag: 100a7a1d-e06d-5e57-886a-8d9bbc73bf7a

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Resellers in the ABC classes picked in the slicer.
	measure 'Resellers in Class' = COUNTROWS ( FILTER ( VALUES ( Resellers[Reseller Code] ), [Reseller ABC Class] IN VALUES ( 'ABC Class'[Class] ) ) )
		formatString: #,0
		displayFolder: Pareto & ABC
		lineageTag: add0dea2-4fed-5f18-8efd-3984c4e9f750

	/// Resellers whose net sales in the current selection (pick a fiscal year) fall in the size band.
	measure 'Resellers in Band' =
			VAR _lo = MIN ( 'Reseller Size Bands'[Band Min] )
			VAR _hi = MAX ( 'Reseller Size Bands'[Band Max] )
			RETURN COUNTROWS ( FILTER ( VALUES ( Resellers[Reseller Code] ),
			    VAR _v = [Net Sales] RETURN NOT ISBLANK ( _v ) && _v >= _lo && _v < _hi ) )
		formatString: #,0
		displayFolder: Pareto & ABC
		lineageTag: 95663cc8-809c-5369-bde0-0ce4d9150fc3

	/// Net sales of the resellers in the size band.
	measure 'Sales in Band' =
			VAR _lo = MIN ( 'Reseller Size Bands'[Band Min] )
			VAR _hi = MAX ( 'Reseller Size Bands'[Band Max] )
			RETURN SUMX ( FILTER ( VALUES ( Resellers[Reseller Code] ),
			    VAR _v = [Net Sales] RETURN NOT ISBLANK ( _v ) && _v >= _lo && _v < _hi ), [Net Sales] )
		displayFolder: Pareto & ABC
		lineageTag: 458b87d0-4e68-5b9c-a946-f43037c4b04f

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Period the new / returning cards count: the date selection, or the last fiscal quarter with sales when no date is picked.
	measure 'Period Counted' =
			VAR _full = MIN ( 'Date'[Date] ) = CALCULATE ( MIN ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) )
			    && MAX ( 'Date'[Date] ) = CALCULATE ( MAX ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) )
			VAR _last = CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS () )
			VAR _lastq = CALCULATE ( MAX ( 'Date'[Fiscal Quarter Number] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] = _last )
			RETURN IF ( _full, CALCULATE ( MAX ( 'Date'[Fiscal Quarter] ), REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Quarter Number] = _lastq ) & " (latest)",
			    FORMAT ( MIN ( 'Date'[Date] ), "mmm yyyy" ) & " – " & FORMAT ( MAX ( 'Date'[Date] ), "mmm yyyy" ) )
		displayFolder: Resellers
		lineageTag: e5351bfa-2652-55f0-b7c9-7a5ff4f50b7f

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Resellers buying in the period counted (latest fiscal quarter with sales when no date is picked).
	measure 'Resellers in Period' =
			VAR _full = MIN ( 'Date'[Date] ) = CALCULATE ( MIN ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) )
			    && MAX ( 'Date'[Date] ) = CALCULATE ( MAX ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) )
			VAR _last = CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS () )
			VAR _lastq = CALCULATE ( MAX ( 'Date'[Fiscal Quarter Number] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] = _last )
			RETURN IF ( _full,
			    CALCULATE (
			        [Active Resellers],
			        REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Quarter Number] = _lastq ),
			    [Active Resellers] )
		formatString: #,0
		displayFolder: Resellers
		lineageTag: 6edfb1d7-c1e1-5e2b-a969-e6cd0e982778

	/// Resellers whose first order ever falls in the period counted (latest fiscal quarter with sales when no date is picked).
	measure 'New Resellers' =
			VAR _full = MIN ( 'Date'[Date] ) = CALCULATE ( MIN ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) )
			    && MAX ( 'Date'[Date] ) = CALCULATE ( MAX ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) )
			VAR _last = CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS () )
			VAR _lastq = CALCULATE ( MAX ( 'Date'[Fiscal Quarter Number] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] = _last )
			RETURN IF ( _full,
			    CALCULATE (
			        COUNTROWS ( FILTER ( ADDCOLUMNS ( VALUES ( Sales[Reseller Code] ),
			            "@first", CALCULATE ( MIN ( Sales[Order Date] ), ALLEXCEPT ( Sales, Sales[Reseller Code] ) ) ),
			            [@first] >= MIN ( 'Date'[Date] ) && [@first] <= MAX ( 'Date'[Date] ) ) ),
			        REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Quarter Number] = _lastq ),
			    COUNTROWS ( FILTER ( ADDCOLUMNS ( VALUES ( Sales[Reseller Code] ),
			        "@first", CALCULATE ( MIN ( Sales[Order Date] ), ALLEXCEPT ( Sales, Sales[Reseller Code] ) ) ),
			        [@first] >= MIN ( 'Date'[Date] ) && [@first] <= MAX ( 'Date'[Date] ) ) ) )
		formatString: #,0
		displayFolder: Resellers
		lineageTag: c2991e30-ef9d-52b8-b81c-64c9b5e030dc

	/// Resellers buying in the period counted who had ordered before it.
	measure 'Returning Resellers' = [Resellers in Period] - [New Resellers]
		formatString: #,0
		displayFolder: Resellers
		lineageTag: a3545ce5-4608-54fc-b10b-fcc31427bf19

	/// Days from the reseller's last order (any date, for the selected rep or region) to the last sale date.
	measure 'Days Since Last Order' =
			VAR _mine = CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS ( 'Date' ) )
			RETURN IF ( NOT ISBLANK ( _mine ), DATEDIFF ( _mine, [Last Sale Date], DAY ) )
		formatString: #,0
		displayFolder: Resellers
		lineageTag: d4b71d3a-a8a0-5d82-99e7-7656e1daf348

	/// Resellers with no order in the last 180 days of data.
	measure 'Churned Resellers' = COUNTROWS ( FILTER ( VALUES ( Resellers[Reseller Code] ), [Days Since Last Order] > 180 ) )
		formatString: #,0
		displayFolder: Resellers
		lineageTag: 907354ad-c00e-5ceb-a605-22b9e581db51

	/// Resellers whose last order was 91 to 180 days before the last sale date.
	measure 'At-Risk Resellers' =
			COUNTROWS ( FILTER ( VALUES ( Resellers[Reseller Code] ),
			    VAR _d = [Days Since Last Order] RETURN _d > 90 && _d <= 180 ) )
		formatString: #,0
		displayFolder: Resellers
		lineageTag: 0cce56e0-1a44-5075-b38e-f05fd51ee229

	/// Active (ordered in the last 90 days), At risk (91–180) or Churned (over 180).
	measure 'Churn Status' =
			VAR _d = [Days Since Last Order]
			RETURN SWITCH ( TRUE (), ISBLANK ( _d ), BLANK (), _d > 180, "Churned", _d > 90, "At risk", "Active" )
		displayFolder: Resellers
		lineageTag: daf8ad2e-bf63-5496-95c6-8cd0409b6fb5

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Share of the resellers that ordered in FY2012 and did not order in FY2013 (the last two full fiscal years).
	measure 'Annual Churn Rate' =
			VAR _prev = CALCULATETABLE ( VALUES ( Sales[Reseller Code] ), REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Year] = "FY2012" )
			VAR _cur = CALCULATETABLE ( VALUES ( Sales[Reseller Code] ), REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Year] = "FY2013" )
			RETURN DIVIDE ( COUNTROWS ( EXCEPT ( _prev, _cur ) ), COUNTROWS ( _prev ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Resellers
		lineageTag: 83681991-4965-5d93-a597-f8c519f1a54d

	/// Expected years a reseller keeps buying: 1 ÷ annual churn rate.
	measure 'Avg Reseller Lifetime' = DIVIDE ( 1, [Annual Churn Rate] )
		formatString: 0.0 "yrs"
		displayFolder: Resellers
		lineageTag: faaa980c-256a-5467-8c39-2bc14e5615d1

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Resellers with an order in FY2013.
	measure 'Resellers FY2013' = CALCULATE ( [Active Resellers], REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Year] = "FY2013" )
		formatString: #,0
		displayFolder: Resellers
		lineageTag: b231b536-4adb-524f-b7d2-1bd781ac0b83

	/// FY2013 net sales per active reseller.
	measure 'Sales per Reseller FY2013' = DIVIDE ( CALCULATE ( [Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Year] = "FY2013" ), [Resellers FY2013] )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Resellers
		lineageTag: 83dc75fa-e48a-515a-b568-8fdc57280e70

	/// FY2013 gross margin per active reseller.
	measure 'Margin per Reseller FY2013' = DIVIDE ( CALCULATE ( [Gross Margin], REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Year] = "FY2013" ), [Resellers FY2013] )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Resellers
		lineageTag: 54c735d1-2309-5966-af94-95a181e6a2c8

	/// Lifetime value on gross margin: FY2013 margin per reseller × expected lifetime.
	measure 'Reseller CLV' = [Margin per Reseller FY2013] * [Avg Reseller Lifetime]
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Resellers
		lineageTag: 5d18023a-f192-530a-a085-c6b150a15413

	/// Lifetime value on net sales: FY2013 sales per reseller × expected lifetime.
	measure 'Reseller CLV on Sales' = [Sales per Reseller FY2013] * [Avg Reseller Lifetime]
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Resellers
		lineageTag: 103b086f-9e30-5ae6-a63f-abdbecb69515

	/// Resellers of the cohort who ordered in quarter N.
	measure 'Cohort Resellers' = SUM ( 'Reseller Cohort'[Cohort Active] )
		formatString: #,0
		displayFolder: Resellers
		lineageTag: db1871e1-5cad-53b9-adbb-404fd958a937

	/// Share of the cohort that ordered again N quarters after the first order.
	measure 'Cohort Retention %' = DIVIDE ( SUM ( 'Reseller Cohort'[Cohort Active] ), SUM ( 'Reseller Cohort'[Cohort Size] ) )
		formatString: 0%
		displayFolder: Resellers
		lineageTag: 19a048aa-a0f5-5478-bc10-22404b53fd70

	/// Heatmap fill for the cohort matrix.
	measure 'Retention Color' =
			VAR _v = [Cohort Retention %]
			RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), _v >= 0.75, "#7FAAD3", _v >= 0.5, "#A9C8E4",
			    _v >= 0.25, "#CFE0F0", "#EEF3F8" )
		displayFolder: Resellers
		lineageTag: a09b60cf-cd54-5a08-ae7f-dbd14cad23f0

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Resellers that moved from the row segment to the column segment.
	measure 'Transition Resellers' = SUM ( 'RFM Transition'[Reseller Count] )
		formatString: #,0
		displayFolder: Resellers
		lineageTag: 760bc53d-dd93-55b8-9ee5-bd1f19a899dc

	/// Share of the FY2012 segment that ended FY2013 in the column segment.
	measure 'Transition Share' =
			DIVIDE ( [Transition Resellers],
			    CALCULATE ( [Transition Resellers], REMOVEFILTERS ( 'RFM Transition'[To Segment], 'RFM Transition'[To Order] ) ) )
		formatString: 0%
		displayFolder: Resellers
		lineageTag: 86e16f5b-640c-5e7c-9846-664d5d4f9b72

	/// Heatmap fill for the transition matrix.
	measure 'Transition Color' =
			VAR _v = [Transition Share]
			RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), _v >= 0.75, "#7FAAD3", _v >= 0.5, "#A9C8E4",
			    _v >= 0.25, "#CFE0F0", "#EEF3F8" )
		displayFolder: Resellers
		lineageTag: c774fb5e-700f-5db6-b0c3-b04edb592419

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Standard scores of the order's net sales against every order in the selection.
	measure 'Order Amount Z' =
			VAR _t = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( Sales[Order Number] ), "@a", [Net Sales] ), ALLSELECTED ( Sales ) )
			RETURN IF ( HASONEVALUE ( Sales[Order Number] ),
			    DIVIDE ( [Net Sales] - AVERAGEX ( _t, [@a] ), STDEVX.P ( _t, [@a] ) ) )
		formatString: 0.00
		displayFolder: Outliers
		lineageTag: d9994005-a53b-5cda-81d4-d55272cc558d

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// 95th percentile of order value in the selection.
	measure 'Order P95' = PERCENTILEX.INC ( ADDCOLUMNS ( VALUES ( Sales[Order Number] ), "@a", [Net Sales] ), [@a], 0.95 )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Outliers
		lineageTag: 257188e3-ad11-5b6e-a855-c8f6fe4061a5

	/// 99th percentile of order value in the selection.
	measure 'Order P99' = PERCENTILEX.INC ( ADDCOLUMNS ( VALUES ( Sales[Order Number] ), "@a", [Net Sales] ), [@a], 0.99 )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Outliers
		lineageTag: 3e0c2d5e-1bd9-5c88-93f0-0c80a5e1ce4a

	/// Above P99 / Above P95 for a single order, against every order in the selection.
	measure 'Order Outlier' =
			VAR _t = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( Sales[Order Number] ), "@a", [Net Sales] ), ALLSELECTED ( Sales ) )
			VAR _v = [Net Sales]
			RETURN IF ( HASONEVALUE ( Sales[Order Number] ),
			    SWITCH ( TRUE (), _v >= PERCENTILEX.INC ( _t, [@a], 0.99 ), "Above P99",
			        _v >= PERCENTILEX.INC ( _t, [@a], 0.95 ), "Above P95" ) )
		displayFolder: Outliers
		lineageTag: 7ab1368d-b733-543f-96db-cc613c631992

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Least-squares line (LINESTX) through monthly net sales up to the last sale, evaluated for the month on the axis.
	measure 'Sales Linear Trend' =
			VAR _last = [Last Sale Date]
			VAR _pts = FILTER (
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Date'[Year Month] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] <= _last ),
			        "@x", INT ( 'Date'[Year Month] / 100 ) * 12 + MOD ( 'Date'[Year Month], 100 ),
			        "@y", VAR _m = 'Date'[Year Month] RETURN CALCULATE ( [Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Year Month] = _m ) ),
			    NOT ISBLANK ( [@y] ) )
			VAR _fit = LINESTX ( _pts, [@y], [@x] )
			VAR _a = MAXX ( _fit, [Intercept] )
			VAR _b = MAXX ( _fit, [Slope1] )
			VAR _ym = MAX ( 'Date'[Year Month] )
			RETURN IF ( HASONEVALUE ( 'Date'[Year Month] ), _a + _b * ( INT ( _ym / 100 ) * 12 + MOD ( _ym, 100 ) ) )
		displayFolder: Forecast
		lineageTag: aa75303d-5589-5608-b42f-90ec88ac891c

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Current fiscal year: sales so far plus the linear trend for the months left until the last quota month (quotas run to Dec 2013), ÷ the quota for the same months.
	measure 'Projected FY Attainment' =
			VAR _last = [Last Sale Date]
			VAR _pts = FILTER (
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Date'[Year Month] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] <= _last ),
			        "@x", INT ( 'Date'[Year Month] / 100 ) * 12 + MOD ( 'Date'[Year Month], 100 ),
			        "@y", VAR _m = 'Date'[Year Month] RETURN CALCULATE ( [Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Year Month] = _m ) ),
			    NOT ISBLANK ( [@y] ) )
			VAR _fit = LINESTX ( _pts, [@y], [@x] )
			VAR _a = MAXX ( _fit, [Intercept] )
			VAR _b = MAXX ( _fit, [Slope1] )
			VAR _fyStart = DATE ( YEAR ( _last ) - IF ( MONTH ( _last ) < 7, 1, 0 ), 7, 1 )
			VAR _qEnd = CALCULATE ( MAX ( Targets[Date] ), REMOVEFILTERS () )
			VAR _s = YEAR ( _last ) * 12 + MONTH ( _last ) + 1
			VAR _e = YEAR ( _qEnd ) * 12 + MONTH ( _qEnd )
			VAR _n = MAX ( 0, _e - _s + 1 )
			// _a + _b * m summed over the months _s.._e: an arithmetic series (closed form, no row iteration)
			VAR _future = _n * _a + _b * ( _s + _e ) * _n * 0.5
			VAR _actual = CALCULATE ( [Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Date] >= _fyStart && 'Date'[Date] <= _last )
			VAR _all = CALCULATE ( SUM ( Targets[Daily Quota] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] >= _fyStart && 'Date'[Date] <= _qEnd )
			VAR _home = CALCULATE ( SUM ( Targets[Daily Quota] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] >= _fyStart && 'Date'[Date] <= _qEnd,
			    TREATAS ( VALUES ( Territories[Territory Key] ), Reps[Territory Key] ) )
			VAR _quota = IF ( ISCROSSFILTERED ( Territories ), _home, _all )
			RETURN IF ( NOT ( ISCROSSFILTERED ( Products ) || ISCROSSFILTERED ( Resellers ) ),
			    DIVIDE ( _actual + _future, _quota * ( 1 + [Stretch %] ) ) )
		formatString: 0%
		displayFolder: Forecast
		lineageTag: 1b9f625e-4a9d-5f2d-8bfe-9782e00ed1ec

	/// One-sentence summary that follows the slicers.
	measure Headline =
			VAR _a = [Attainment]
			VAR _p = [Projected FY Attainment]
			VAR _proj = IF ( NOT ISBLANK ( _p ), " On the monthly trend, FY" & ( YEAR ( [Last Sale Date] ) + IF ( MONTH ( [Last Sale Date] ) >= 7, 1, 0 ) )
			    & " ends the quota months (to Dec 2013) at " & FORMAT ( _p, "0%" ) & " of target." )
			RETURN
			    IF ( ISBLANK ( _a ),
			        "Sales " & FORMAT ( [Net Sales] / 1e6, "$#,0.0" ) & "M. No target applies to this selection.",
			        "Sales " & FORMAT ( [Net Sales] / 1e6, "$#,0.0" ) & "M against a target of "
			            & FORMAT ( [Target] / 1e6, "$#,0.0" ) & "M: " & FORMAT ( _a, "0%" ) & ", " & LOWER ( [Status] ) & ". "
			            & [Reps On Target] & " of " & [Reps With Target] & " reps are on target. Best attainment: "
			            & [Top Rep] & "." & _proj )
		displayFolder: Narrative
		lineageTag: a4b7c582-cd0a-578e-bf10-c9917fa0fa98

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cf3f0cc3-1ba5-5c02-af60-20619697a8f1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = {1}
