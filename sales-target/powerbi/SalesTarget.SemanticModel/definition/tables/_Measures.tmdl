	/// Net sales less units × standard cost (Products[Standard Cost] through RELATED). Hidden from Sales Manager by object-level security on the cost column, so it errors in that role.
	measure 'Gross Margin' = SUMX ( Sales, Sales[Amount] - Sales[Quantity] * RELATED ( Products[Standard Cost] ) )
		displayFolder: Profit
		lineageTag: 27001148-25ea-531d-8542-c83767282f51

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
