				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Gross margin ÷ net sales.
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Net Sales] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Profit
		lineageTag: 75f3095e-6251-5d01-8ccf-9588350c2257

	/// Selected what-if stretch on top of quota; 0% by default.
	measure 'Stretch %' = SELECTEDVALUE ( 'Target Stretch'[Target Stretch], 0 )
		formatString: 0%
		displayFolder: Target
		lineageTag: 05c30473-b04e-51a2-82db-f4f68873d537

	/// Quota up to the last sale date. Quotas are per rep, so territories use the rep's home territory and product or reseller filters return blank.
	measure Quota =
			VAR _last = CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS () )
			VAR _q =
			    CALCULATE ( SUM ( Targets[Daily Quota] ), KEEPFILTERS ( 'Date'[Date] <= _last ) )
			RETURN
			    SWITCH ( TRUE (),
			        ISCROSSFILTERED ( Products ) || ISCROSSFILTERED ( Resellers ), BLANK (),
			        ISCROSSFILTERED ( Territories ),
			            CALCULATE ( SUM ( Targets[Daily Quota] ), KEEPFILTERS ( 'Date'[Date] <= _last ),
			                TREATAS ( VALUES ( Territories[Territory Key] ), Reps[Territory Key] ) ),
			        _q )
		displayFolder: Target
		lineageTag: d8858fff-3aa6-5738-a846-127fae9939f9

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Quota × (1 + stretch).
	measure Target = [Quota] * ( 1 + [Stretch %] )
		displayFolder: Target
		lineageTag: 81186f57-0653-54ea-a5e6-85fc07e8437a

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Sales − target (UDF Sales.Gap).
	measure 'Gap to Target' = Sales.Gap ( [Net Sales], [Target] )
		displayFolder: Target
