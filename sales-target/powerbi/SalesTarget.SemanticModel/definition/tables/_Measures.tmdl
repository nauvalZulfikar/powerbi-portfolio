	/// Rolling 12-month sales ÷ rolling 12-month target.
	measure 'Attainment R12M' = Sales.Attainment ( [Sales R12M], [Target R12M] )
		formatString: 0%
		displayFolder: Target
		lineageTag: c149cdc2-80c6-599d-adaf-fd6c57674e9b

	/// Attainment in the fiscal quarter before the latest one in the filter (OFFSET -1 over the fiscal quarters).
	measure 'Attainment Prev FQ' =
			VAR _d = MIN ( [Last Sale Date], MAX ( 'Date'[Date] ) )
			VAR _q = LOOKUPVALUE ( 'Date'[Fiscal Quarter Number], 'Date'[Date], _d )
			RETURN
			    CALCULATE (
			        CALCULATE ( [Attainment],
			            OFFSET ( -1, ALLSELECTED ( 'Date'[Fiscal Quarter Number] ), ORDERBY ( 'Date'[Fiscal Quarter Number] ) ) ),
			        'Date'[Fiscal Quarter Number] = _q )
		formatString: 0%
		displayFolder: Target
		lineageTag: e15413de-87dd-5054-8b93-25e3528757ea

	/// A rep's sales as a share of their manager's team (Org Level 1, the manager at the top of the rep's path). ALLEXCEPT keeps the team filter; VALUES puts it back when only the rep is on the rows.
	measure 'Rep Share of Team' =
			VAR _team = VALUES ( Reps[Org Level 1] )
			RETURN DIVIDE ( [Net Sales], CALCULATE ( [Net Sales], ALLEXCEPT ( Reps, Reps[Org Level 1] ), _team ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Target
		lineageTag: cdefc968-6c1b-5766-834f-73ce12135bcd

	/// Net sales of the reps whose status is At risk (90–99%).
	measure 'Sales from At-Risk Reps' = CALCULATE ( [Net Sales], FILTER ( VALUES ( Reps[Rep Key] ), [Status] = "At risk" ) )
		displayFolder: Target
		lineageTag: bf89f078-d4c4-59f6-9f18-47a8b72acfd8

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Reps with a target on the last day of the filter (LASTDATE): a semi-additive head count.
	measure 'Active Reps (End of Period)' = CALCULATE ( DISTINCTCOUNT ( Targets[Rep Key] ), LASTDATE ( 'Date'[Date] ) )
		formatString: #,0
		displayFolder: Target
		lineageTag: 4210a66e-e063-5d25-9372-91f4236a4081

	/// Rep with the highest attainment in the current selection (INDEX 1 by attainment).
	measure 'Top Rep' =
			VAR _top = INDEX ( 1, ALLSELECTED ( Reps[Rep] ), ORDERBY ( [Attainment], DESC ) )
			RETURN MAXX ( _top, Reps[Rep] )
		displayFolder: Target
		lineageTag: aa48e462-cd93-5571-aa4e-5c696127358f

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Best attainment among the reps of the same home region (INDEX 1, PARTITIONBY Reps[Home Region]). On a rep's row it names the leader of that rep's region; with no region in context it lists every region's leader.
	measure 'Top Rep in Region' =
			VAR _top =
			    INDEX ( 1, ALLSELECTED ( Reps[Rep], Reps[Home Region] ), ORDERBY ( [Attainment], DESC ), KEEP,
			        PARTITIONBY ( Reps[Home Region] ) )
			RETURN CONCATENATEX ( _top, Reps[Rep], ", " )
		displayFolder: Target
		lineageTag: 3afe1722-5b77-5c42-8f53-53cd092caea2

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// SYNTHETIC category plan (Category Plan table). Set per category and fiscal quarter, so rep, region and reseller filters return blank, and a month shows its whole quarter.
	measure 'Category Target' =
			IF ( ISCROSSFILTERED ( Reps ) || ISCROSSFILTERED ( Territories ) || ISCROSSFILTERED ( Resellers ),
			    BLANK (),
			    SUM ( 'Category Plan'[Plan Amount] ) )
		displayFolder: Plan
		lineageTag: 9c3ba21d-1b9a-53b8-a827-a53cc8934542

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH ( TRUE (),
				        _v >= 1e6, "$#,0.0,,""M"";($#,0.0,,""M"")",
				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Sales in the planned quarters ÷ category target (synthetic plan).
	measure 'Category Attainment' =
			DIVIDE (
			    CALCULATE ( [Net Sales], KEEPFILTERS ( TREATAS ( VALUES ( 'Category Plan'[Fiscal Quarter] ), 'Date'[Fiscal Quarter] ) ) ),
			    [Category Target] )
		formatString: 0%
		displayFolder: Plan
		lineageTag: eac226b3-8df1-58df-b2ad-eb69d1a7a0d8

	/// Fiscal year to date (July–June), from the Fiscal calendar.
	measure 'Sales FYTD' = CALCULATE ( [Net Sales], DATESYTD ( 'Fiscal' ) )
