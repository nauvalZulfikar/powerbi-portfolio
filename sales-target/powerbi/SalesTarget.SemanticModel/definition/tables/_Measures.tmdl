				        _v >= 1e3, "$#,0,""K"";($#,0,""K"")",
				        "$#,0;($#,0)" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Average net sales per month in the filter (months without sales skipped). Constant line on Time & Fiscal.
	measure 'Avg Monthly Sales' = AVERAGEX ( VALUES ( 'Date'[Year Month] ), [Net Sales] )
		displayFolder: Sales
		lineageTag: 8eaab32d-ee5e-5948-b887-a97e1aa1811d

