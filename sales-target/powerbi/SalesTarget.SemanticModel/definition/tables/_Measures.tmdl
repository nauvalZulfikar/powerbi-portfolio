		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Reps whose attainment is 100% or more.
	measure 'Reps On Target' = COUNTROWS ( FILTER ( VALUES ( Reps[Rep Key] ), [Attainment] >= 1 ) )
		formatString: #,0
		displayFolder: Target
		lineageTag: fe3c4ff4-23a0-5620-87a7-a088ba56469c

	/// Reps that have a target in the current filter.
	measure 'Reps With Target' = COUNTROWS ( FILTER ( VALUES ( Reps[Rep Key] ), NOT ISBLANK ( [Target] ) ) )
		formatString: #,0
		displayFolder: Target
		lineageTag: 60da1a6c-778a-5f14-b7f2-9fc646a39a47

	/// Target over the rolling 12 months (DATESINPERIOD).
	measure 'Target R12M' = CALCULATE ( [Target], DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -12, MONTH ) )
		displayFolder: Target
		lineageTag: 961a2421-8d59-560c-89fa-7532d9c656bb

