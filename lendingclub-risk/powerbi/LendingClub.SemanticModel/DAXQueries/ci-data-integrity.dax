// pbi-kit CI test, generated by src/build_model.py (kit_tests). Expected values: assert file next to this one.
// Mirrors sql/90_tests.sql inside the model: every count must be 0.
EVALUATE
ROW (
    "Duplicate Loan IDs", COUNTROWS ( Loans ) - DISTINCTCOUNT ( Loans[Loan ID] ),
    "Loans Without Grade", COUNTROWS ( FILTER ( Loans, ISBLANK ( RELATED ( Grade[Sub Grade] ) ) ) ) + 0,
    "Loans Without State", COUNTROWS ( FILTER ( Loans, ISBLANK ( RELATED ( State[State Code] ) ) ) ) + 0,
    "Loans Without Purpose", COUNTROWS ( FILTER ( Loans, ISBLANK ( RELATED ( Purpose[Purpose Code] ) ) ) ) + 0,
    "PD Out Of Range", COUNTROWS ( FILTER ( Loans, ISBLANK ( Loans[PD] ) || Loans[PD] < 0 || Loans[PD] > 1 ) ) + 0,
    "Rates Out Of Range", COUNTROWS ( FILTER ( Loans, Loans[Interest Rate] < 0.05 || Loans[Interest Rate] > 0.31 ) ) + 0,
    "LGD Out Of Range", COUNTROWS ( FILTER ( 'Grade LGD', 'Grade LGD'[Grade LGD Rate] < 0 || 'Grade LGD'[Grade LGD Rate] > 1 ) ) + 0
)
