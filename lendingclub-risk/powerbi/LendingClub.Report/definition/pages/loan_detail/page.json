{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "loan_detail",
  "displayName": "Loan Detail",
  "displayOption": "FitToPage",
  "width": 1600,
  "height": 900,
  "type": "Drillthrough",
  "visibility": "HiddenInViewMode",
  "filterConfig": {
    "filters": [
      {
        "name": "dt_subgrade",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Grade"
              }
            },
            "Property": "Sub Grade"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "dt_state",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "State"
              }
            },
            "Property": "State Name"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "dt_purpose",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Purpose"
              }
            },
            "Property": "Purpose"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "live_only",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Loans"
              }
            },
            "Property": "Outcome"
          }
        },
        "type": "Categorical",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "t",
              "Entity": "Loans",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "t"
                          }
                        },
                        "Property": "Outcome"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "'Current'"
                        }
                      }
                    ],
                    [
                      {
                        "Literal": {
                          "Value": "'Delinquent'"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        },
        "isLockedInViewMode": true
      }
    ]
  },
  "pageBinding": {
    "name": "loan_detail_binding",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "p_subgrade",
        "boundFilter": "dt_subgrade",
        "asAggregation": false,
        "qnaSingleSelectRequired": false,
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Grade"
              }
            },
            "Property": "Sub Grade"
          }
        }
      },
      {
        "name": "p_state",
        "boundFilter": "dt_state",
        "asAggregation": false,
        "qnaSingleSelectRequired": false,
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "State"
              }
            },
            "Property": "State Name"
          }
        }
      },
      {
        "name": "p_purpose",
        "boundFilter": "dt_purpose",
        "asAggregation": false,
        "qnaSingleSelectRequired": false,
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Purpose"
              }
            },
            "Property": "Purpose"
          }
        }
      }
    ]
  },
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'canvas.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "canvas.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#E9E8E3'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
