<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="TeamKPI">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=powerbi://api.powerbi.com/v1.0/myorg/Team KPI [Prod];Initial Catalog=TeamKPI</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Teams">
      <Query><DataSourceName>TeamKPI</DataSourceName>
        <CommandText>EVALUATE VALUES ( Teams[Team] ) ORDER BY Teams[Team]</CommandText></Query>
      <Fields><Field Name="Team"><DataField>Teams[Team]</DataField></Field></Fields>
    </DataSet>
    <DataSet Name="Breached">
      <Query>
        <DataSourceName>TeamKPI</DataSourceName>
        <QueryParameters><QueryParameter Name="Team"><Value>=Parameters!Team.Value</Value></QueryParameter></QueryParameters>
        <CommandText>EVALUATE
CALCULATETABLE (
    SELECTCOLUMNS (
        FILTER ( Tickets, Tickets[Resolution SLA] = "Open, breached" ),
        "Ticket", Tickets[Ticket Key],
        "Team", RELATED ( Teams[Team] ),
        "Priority", RELATED ( Priorities[Priority] ),
        "Status", Tickets[Status],
        "Age Days", Tickets[Age Days],
        "Days Past Target", Tickets[Days Past Target]
    ),
    TREATAS ( { @Team }, Teams[Team] )
)
ORDER BY [Days Past Target] DESC</CommandText>
      </Query>
      <Fields><Field Name="Ticket"><DataField>[Ticket]</DataField></Field><Field Name="Team"><DataField>[Team]</DataField></Field><Field Name="Priority"><DataField>[Priority]</DataField></Field><Field Name="Status"><DataField>[Status]</DataField></Field><Field Name="Age_Days"><DataField>[Age Days]</DataField></Field><Field Name="Days_Past_Target"><DataField>[Days Past Target]</DataField></Field></Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Team">
      <DataType>String</DataType>
      <Prompt>Team</Prompt>
      <ValidValues><DataSetReference><DataSetName>Teams</DataSetName><ValueField>Team</ValueField>
        <LabelField>Team</LabelField></DataSetReference></ValidValues>
    </ReportParameter>
  </ReportParameters>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>="Breached open tickets: " &amp; Parameters!Team.Value</Value>
              <Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph>
            <Paragraph><TextRuns><TextRun><Value>Open tickets past their resolution target, most overdue first. Sent every Monday.</Value>
              <Style><FontSize>9pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
            <Top>0in</Top><Left>0in</Left><Height>0.7in</Height><Width>7in</Width><Style /></Textbox>
          <Tablix Name="BreachedTable">
            <TablixBody>
              <TablixColumns><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1in</Width></TablixColumn><TablixColumn><Width>1in</Width></TablixColumn><TablixColumn><Width>1.5in</Width></TablixColumn><TablixColumn><Width>1in</Width></TablixColumn><TablixColumn><Width>1.3in</Width></TablixColumn></TablixColumns>
              <TablixRows>
                <TablixRow><Height>0.3in</Height><TablixCells><TablixCell><CellContents><Textbox Name="h_Ticket"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ticket</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Team"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Team</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Priority"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Priority</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Status"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Status</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Age_Days"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Age Days</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Days_Past_Target"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Days Past Target</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="d_Ticket"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Ticket.Value</Value><Style></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Team"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Team.Value</Value><Style></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Priority"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Priority.Value</Value><Style></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Status"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Status.Value</Value><Style></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Age_Days"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Age_Days.Value</Value><Style><Format>#,0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Days_Past_Target"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Days_Past_Target.Value</Value><Style><Format>#,0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
            <TablixRowHierarchy><TablixMembers>
              <TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember>
              <TablixMember><Group Name="Details" /></TablixMember>
            </TablixMembers></TablixRowHierarchy>
            <DataSetName>Breached</DataSetName>
            <Top>0.8in</Top><Left>0in</Left><Height>0.55in</Height><Width>7in</Width><Style /></Tablix>
        </ReportItems>
        <Height>1.5in</Height><Style />
      </Body>
      <Width>7in</Width>
      <Page>
        <PageHeight>11in</PageHeight><PageWidth>8.5in</PageWidth>
        <LeftMargin>0.75in</LeftMargin><RightMargin>0.75in</RightMargin><TopMargin>0.5in</TopMargin><BottomMargin>0.5in</BottomMargin>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
  <ReportParametersLayout><GridLayoutDefinition><NumberOfColumns>1</NumberOfColumns><NumberOfRows>1</NumberOfRows>
    <CellDefinitions><CellDefinition><ColumnIndex>0</ColumnIndex><RowIndex>0</RowIndex><ParameterName>Team</ParameterName>
    </CellDefinition></CellDefinitions></GridLayoutDefinition></ReportParametersLayout>
