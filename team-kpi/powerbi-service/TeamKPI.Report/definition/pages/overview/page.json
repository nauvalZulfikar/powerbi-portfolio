{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "overview",
  "displayName": "Overview",
  "displayOption": "FitToPage",
  "width": 1600,
  "height": 900,
  "visualInteractions": [
    {
      "source": "bar_delivered_by",
      "target": "line_cumulative",
      "type": "DataFilter"
    },
    {
      "source": "bar_delivered_by",
      "target": "bar_sla_by",
      "type": "HighlightFilter"
    },
    {
      "source": "bar_delivered_by",
      "target": "kpi_0",
      "type": "NoFilter"
    },
    {
      "source": "bar_delivered_by",
      "target": "kpi_1",
      "type": "NoFilter"
    },
    {
      "source": "bar_delivered_by",
      "target": "kpi_2",
      "type": "NoFilter"
    },
    {
      "source": "bar_delivered_by",
      "target": "kpi_3",
      "type": "NoFilter"
    },
    {
      "source": "bar_delivered_by",
      "target": "kpi_4",
      "type": "NoFilter"
    },
    {
      "source": "bar_delivered_by",
      "target": "kpi_5",
      "type": "NoFilter"
    }
  ],
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'canvas.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "canvas.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#E9E8E3'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
