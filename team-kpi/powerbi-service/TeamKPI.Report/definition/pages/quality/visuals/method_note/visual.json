          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How four different Jira workflows become one",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each team names its statuses differently: Cassandra moves tickets through triage, review and \"ready to commit\"; Hive mostly goes straight from open to resolved. A mapping table puts every status into one of four shared stages (backlog, in progress, in review, done), and every priority into P1–P4.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Every number is as of 30 Sep 2026. The full change history is replayed, so a ticket closed in October still counts as open on that date and the figures don't drift between refreshes.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "First response is the first change by anyone other than the reporter; comments aren't pulled.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
