{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "ticket_list",
  "displayName": "Ticket List",
  "displayOption": "FitToPage",
  "width": 1600,
  "height": 900,
  "type": "Drillthrough",
  "visibility": "HiddenInViewMode",
  "filterConfig": {
    "filters": [
      {
        "name": "dt_team",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Teams"
              }
            },
            "Property": "Team"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "dt_person",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "People"
              }
            },
            "Property": "Person"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "dt_priority",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Priorities"
              }
            },
            "Property": "Priority"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "open_only",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Stages"
              }
            },
            "Property": "Is Open"
          }
        },
        "type": "Categorical",
        "howCreated": "User",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "t",
              "Entity": "Stages",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "t"
                          }
                        },
                        "Property": "Is Open"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "true"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        },
        "isLockedInViewMode": true
      }
    ]
  },
  "pageBinding": {
    "name": "ticket_list_binding",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "p_team",
        "boundFilter": "dt_team",
        "asAggregation": false,
        "qnaSingleSelectRequired": false,
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Teams"
              }
            },
            "Property": "Team"
          }
        }
      },
      {
        "name": "p_person",
        "boundFilter": "dt_person",
        "asAggregation": false,
        "qnaSingleSelectRequired": false,
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "People"
              }
            },
            "Property": "Person"
          }
        }
      },
      {
        "name": "p_priority",
        "boundFilter": "dt_priority",
        "asAggregation": false,
        "qnaSingleSelectRequired": false,
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Priorities"
              }
            },
            "Property": "Priority"
          }
        }
      }
    ]
  },
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'canvas.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "canvas.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#E9E8E3'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
