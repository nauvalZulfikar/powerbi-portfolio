		formatString: 0
		isHidden
		lineageTag: 58c13503-7547-5688-bff4-85314a03a23a
		summarizeBy: none

	column 'Win Band' = SWITCH ( Driver[Win Band Order], 1, "No wins", 2, "Under 5%", 3, "5–19%", "20%+" )
		dataType: string
		sortByColumn: 'Win Band Order'
