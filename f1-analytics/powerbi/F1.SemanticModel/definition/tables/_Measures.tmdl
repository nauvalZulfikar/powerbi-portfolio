table _Measures
	lineageTag: f9c33346-542b-53b7-a2f2-118b073c6220

	/// Grands Prix held in the current filter context.
	measure Races = DISTINCTCOUNT ( Results[Race Id] )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 2138be61-d8af-5e3b-a433-f8fd406edd8d

	/// Distinct seasons in the current filter context.
	measure Seasons = DISTINCTCOUNT ( Race[Race Year] )
		formatString: #,0
		displayFolder: Racing
		lineageTag: c48cf0b3-79ae-50fd-a125-1ff289d935d9

	/// Race entries that took the start (grid slot or classified).
	measure Starts = CALCULATE ( COUNTROWS ( Results ), Results[Status Group] <> "Did not start" )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 3965ee33-78ab-5c60-9d44-bf818d288386

	/// Race wins.
	measure Wins = CALCULATE ( COUNTROWS ( Results ), Results[Is Win] = TRUE () )
		formatString: #,0
		displayFolder: Racing
		lineageTag: e8df5779-bcc9-54b8-8e0e-677b983ff622

	/// Top-three finishes.
	measure Podiums = CALCULATE ( COUNTROWS ( Results ), Results[Is Podium] = TRUE () )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 150464d8-3ffa-56d7-8770-86a7f38acfb3

	/// Started from grid slot 1.
	measure Poles = CALCULATE ( COUNTROWS ( Results ), Results[Is Pole] = TRUE () )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 331e95fb-e2ec-55da-9625-9daff4f6a3e8

	/// Races in which the driver set the fastest lap.
	measure 'Fastest Laps' = CALCULATE ( COUNTROWS ( Results ), Results[Is Fastest Lap] = TRUE () )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 2124732c-dc4e-51d4-80bd-7f319556c23b

	/// Championship points as awarded at the time.
	measure Points = SUM ( Results[Points Scored] )
		formatString: #,0.0
		displayFolder: Racing
		lineageTag: f449dbbb-31f8-5b1f-b0e4-7ddb9d323642

	/// Points re-scored on today's 25-18-15-12-10-8-6-4-2-1 system, comparable across eras.
	measure 'Points (Modern Scale)' = SUM ( Results[Modern Points] )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 85209fea-2f38-55ec-882a-6faffaf167ed

	/// Wins per start (UDF F1.Rate).
	measure 'Win Rate' = F1.Rate ( [Wins], [Starts] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Racing
		lineageTag: 3297e117-73ac-561c-a41a-e6927ba01c91

	/// Podiums per start (UDF F1.Rate).
	measure 'Podium Rate' = F1.Rate ( [Podiums], [Starts] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Racing
		lineageTag: 3814e226-833c-50e3-b2a6-848b9006eb24

	/// Share of pole positions turned into a win.
	measure 'Pole Conversion' = DIVIDE ( CALCULATE ( COUNTROWS ( Results ), Results[Is Pole] = TRUE (), Results[Is Win] = TRUE () ), [Poles] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Racing
		lineageTag: 908b2f17-52e3-5830-99ba-1a8d114178cc

	/// Grid slot minus finishing position (classified finishers).
	measure 'Avg Positions Gained' = AVERAGE ( Results[Positions Gained Value] )
		formatString: +0.0;-0.0;0.0
		displayFolder: Racing
		lineageTag: 0731edc4-fb0e-5505-a7ad-bde90ac957bd

	/// 1 = won, 0 = last classified. Comparable across field sizes.
	measure 'Avg Finish Percentile' = AVERAGE ( Results[Finish Percentile Value] )
		formatString: 0%
		displayFolder: Racing
		lineageTag: b262722a-0149-551f-a611-ef413fd41202

	/// Distinct drivers with at least one race entry.
	measure Drivers = DISTINCTCOUNT ( Results[Driver Id] )
		formatString: #,0
		displayFolder: Racing
		lineageTag: c167c354-a86b-55f5-ae1c-ecc29e5822fb

	/// Distinct constructors with at least one race entry.
	measure Constructors = DISTINCTCOUNT ( Results[Constructor Id] )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 778a926c-9dc6-5f35-9d25-8dce73eac5ac

	/// Distinct drivers who won at least one race.
	measure 'Different Winners Count' = CALCULATE ( DISTINCTCOUNT ( Results[Driver Id] ), Results[Is Win] = TRUE () )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 002b47ef-cd02-57c1-bfa2-4f80514637dd

	/// Distinct circuits that hosted a race in the current filter context.
	measure 'Circuits Used' = CALCULATE ( DISTINCTCOUNT ( Race[Circuit Id] ), Results )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 92278b2b-765b-5f03-a439-957092139341

	/// For map bubbles.
	measure 'Map Latitude' = AVERAGE ( Circuit[Latitude] )
		formatString: 0.0000
		displayFolder: Racing
		lineageTag: 182457f2-ed48-5e1d-b0d2-503e89a7f3d0

	/// For map bubbles.
	measure 'Map Longitude' = AVERAGE ( Circuit[Longitude] )
		formatString: 0.0000
		displayFolder: Racing
		lineageTag: 8c2847b2-7c60-556f-b78e-8b9b2ded5dd0

	/// Grands Prix held at the circuit (all time, ignores season filters).
	measure 'Circuit Races Hosted' = SUM ( Circuit[Races Hosted] )
		formatString: #,0
		displayFolder: Racing
		lineageTag: 6d551262-199f-500e-bd9b-08198d52ea79

	/// Share of races at the circuit won from pole.
	measure 'Circuit Pole Win Rate' = AVERAGE ( Circuit[Pole Win Rate] )
		formatString: 0%
		displayFolder: Racing
		lineageTag: 3c65862f-a52a-5c6d-9f62-d6a9d5a6803c

	/// Highest fastest-lap average speed (2004+ data).
	measure 'Top Speed kph' = MAX ( Results[Fastest Lap Kph] )
		formatString: #,0.0
		displayFolder: Racing
		lineageTag: a7551bd6-d5de-5b8e-99ec-728ff7b19c82

	/// Share of starts that ended in retirement (UDF F1.Rate).
	measure 'DNF Rate' = F1.Rate ( CALCULATE ( COUNTROWS ( Results ), Results[Is DNF] = TRUE () ), [Starts] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Reliability
		lineageTag: 4c7d78a8-4444-5861-a0df-7ee1fe0e4390

	/// Share of starts that ended in a mechanical retirement.
	measure 'Mechanical DNF Rate' = DIVIDE ( CALCULATE ( COUNTROWS ( Results ), Results[Is Mechanical DNF] = TRUE () ), [Starts] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Reliability
		lineageTag: e615b9d8-9d2f-5057-95a3-b844238d1144

	/// Share of starts that ended in a crash or driver-caused retirement.
	measure 'Crash DNF Rate' = DIVIDE ( CALCULATE ( COUNTROWS ( Results ), Results[Status Group] = "Crash / driver" ), [Starts] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Reliability
		lineageTag: 9f3491c9-d73c-5256-bccc-4b55e99fb6c2

	/// Share of starts that were classified at the finish.
	measure 'Finish Rate' = DIVIDE ( CALCULATE ( COUNTROWS ( Results ), Results[Is Finished] = TRUE () ), [Starts] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Reliability
		lineageTag: c42d7b10-5289-5661-b8a5-12ae7aad0425

	/// Share of starts by outcome group (for 100% stacked charts).
	measure 'Outcome Share' = DIVIDE ( [Starts], CALCULATE ( [Starts], ALL ( Results[Status Group] ) ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Reliability
		lineageTag: 3f14909d-3826-5942-84e6-d873d8fadd00

	/// World Drivers' Championships won by the drivers in context.
	measure 'Driver Titles Won' = CALCULATE ( COUNTROWS ( Season ), TREATAS ( VALUES ( Driver[Driver Id] ), Season[Champion Driver Id] ), REMOVEFILTERS ( Race ) )
		formatString: #,0
		displayFolder: Championship
		lineageTag: 462f7b3e-60d4-5b95-8338-d6ec0a91f1ad

	/// Cumulative points in the standings after the round in context.
	measure 'Championship Points' = MAX ( Standings[Standing Points] )
		formatString: #,0.0
		displayFolder: Championship
		lineageTag: 7d6fa034-1b63-529e-9a9a-09db144a96cf

	/// Championship points behind the standings leader (smallest gap in context).
	measure 'Gap to Leader' = MIN ( Standings[Standing Gap] )
		formatString: +#,0;-#,0;0
		displayFolder: Championship
		lineageTag: 9835b827-e2f8-532c-96a7-fcac8ccb28ce

	/// Points after the last round of the season in context.
	measure 'Final Standings Points' =
			VAR _last = CALCULATE ( MAX ( Standings[Standings Round] ), REMOVEFILTERS ( Driver ) )
			RETURN CALCULATE ( MAX ( Standings[Standing Points] ), Standings[Standings Round] = _last )
		formatString: #,0.0
		displayFolder: Championship
		lineageTag: e42bc7a9-2860-5a88-b853-c271b6a576df

	/// Points from sprint races (2021+), shaped in Power Query from the raw CSV.
	measure 'Sprint Points Scored' = SUM ( 'Sprint Results'[Sprint Points] )
		formatString: #,0.0
		displayFolder: Championship
		lineageTag: 66445153-b4cf-5e73-8d15-fbf8298f4aee

	/// Grand Prix + sprint points: the appended 'Session Results' query. Equals the standings.
	measure 'Points incl. Sprints' = SUM ( 'Session Results'[Session Points] )
		formatString: #,0.0
		displayFolder: Championship
		lineageTag: 17dcb146-7a21-5d8f-8dde-a52fb6781cb6

	/// Classified finishes re-scored with the points system picked in the 'Points Systems' slicer (default: today's 25-18-15…).
	measure 'Points (Chosen System)' =
			VAR _sys = SELECTEDVALUE ( 'Points Systems'[System], "2010–" )
			RETURN SUMX ( FILTER ( ALL ( 'Points Systems' ), 'Points Systems'[System] = _sys ),
			    VAR _p = 'Points Systems'[Position] RETURN 'Points Systems'[System Points] * CALCULATE ( COUNTROWS ( Results ), Results[Finish Position] = _p ) )
		formatString: #,0
		displayFolder: Championship
		lineageTag: e8ec0dfd-be49-594e-be29-81160f821eb5

	/// Constructor share of all modern-scale points in the season(s) in context.
	measure 'Team Points Share' = DIVIDE ( SUM ( 'Team Season'[Team Modern Points] ), CALCULATE ( SUM ( 'Team Season'[Team Modern Points] ), REMOVEFILTERS ( Constructor ) ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Championship
		lineageTag: 12ad11bf-342a-5cbe-94ea-416ca1beaccf

	/// How dominant the best team was: its share of the season's points.
	measure 'Avg Top Team Share' = AVERAGE ( Season[Top Team Points Share] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Championship
		lineageTag: 6699c7c5-4114-505a-97a1-db7f0778f08a

	/// Average of each season's champion win rate (wins per start of the drivers' champion).
	measure 'Avg Champion Win Rate' = AVERAGE ( Season[Champion Win Rate] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Championship
		lineageTag: 555e1a0a-6667-5a6a-bdcb-73d8d6dc2562

	/// Champion's points lead over the runner-up, as a share of the champion's points.
	measure 'Avg Title Margin %' = AVERAGE ( Season[Title Margin Pct] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Championship
		lineageTag: 4c59f963-01e1-5364-9eff-876cedc987ab

	/// Best qualifying lap vs the pole lap (1994+ data).
	measure 'Avg Gap to Pole' = AVERAGE ( Qualifying[Gap To Pole Pct] )
		formatString: 0.00%
		displayFolder: Qualifying
		lineageTag: 7ad1946a-d936-5a74-af28-8a66d598e7ff

	/// Average starting grid slot.
	measure 'Avg Grid' = AVERAGE ( Results[Grid Position] )
		formatString: #,0.0
		displayFolder: Qualifying
		lineageTag: d27f238b-400c-57ce-9752-918a1e9f8945

	/// Historic chance of winning from this starting slot.
	measure 'Grid Win Probability' = DIVIDE ( SUM ( 'Grid Conversion'[Slot Wins] ), SUM ( 'Grid Conversion'[Slot Starts] ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Qualifying
		lineageTag: 5a7e7281-8ed1-5d27-9d6a-bf4885bf62b1

	/// Historical chance of a podium from the selected grid slot.
	measure 'Grid Podium Probability' = DIVIDE ( SUM ( 'Grid Conversion'[Slot Podiums] ), SUM ( 'Grid Conversion'[Slot Starts] ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Qualifying
		lineageTag: 9d0f8654-5a9f-59d6-a67d-5bc7213042b4

	/// Pit stops recorded (pit-stop data, 2011 onward).
	measure 'Pit Stops Made' = COUNTROWS ( 'Pit Stops' )
		formatString: #,0
		displayFolder: Pit Stops & Laps
		lineageTag: 5cf7ef35-e87b-5eac-b508-15468bb87870

	/// Pit-lane entry to exit, routine stops only (≤ 60 s). 2011+ data.
	measure 'Median Pit Lane Time' = CALCULATE ( MEDIAN ( 'Pit Stops'[Pit Seconds] ), 'Pit Stops'[Is Routine Stop] = TRUE () )
		formatString: 0.00" s"
		displayFolder: Pit Stops & Laps
		lineageTag: 5a7cdd71-153a-512b-84a0-09fcea601ebe

	/// Quickest routine pit-lane time in seconds (excludes repairs and penalties).
	measure 'Fastest Pit Lane Time' = CALCULATE ( MIN ( 'Pit Stops'[Pit Seconds] ), 'Pit Stops'[Is Routine Stop] = TRUE () )
		formatString: 0.00" s"
		displayFolder: Pit Stops & Laps
		lineageTag: 948387c1-7a80-5796-87fa-3e11012a247f

	/// Average stops per driver per race.
	measure 'Stops per Race' = DIVIDE ( [Pit Stops Made], COUNTROWS ( SUMMARIZE ( 'Pit Stops', 'Pit Stops'[Race Id], 'Pit Stops'[Driver Id] ) ) )
		formatString: 0.00
		displayFolder: Pit Stops & Laps
		lineageTag: 3e93bf59-0a7a-59b7-8d72-05981bc5e6e8

	/// Position at the end of the lap (race-story chart, axis reversed).
	measure 'Running Position' = MIN ( 'Lap Times'[Lap Position] )
		formatString: 0
		displayFolder: Pit Stops & Laps
		lineageTag: 46445948-0b45-5288-b4c8-4cda6a585e36

	/// Seconds; the dynamic format string shows it as m:ss.000 (90.013 → 1:30.013).
	measure 'Avg Lap Time' = CALCULATE ( AVERAGE ( 'Lap Times'[Lap Seconds] ), 'Lap Times'[Is Pit Lap] = FALSE () )
		displayFolder: Pit Stops & Laps
		lineageTag: 6b8eef56-0b08-52c4-8d44-815a39fc4542
		formatStringDefinition = VAR _s = SELECTEDMEASURE () VAR _m = INT ( _s / 60 ) RETURN IF ( ISBLANK ( _s ), "0.000", """" & _m & ":" & FORMAT ( _s - 60 * _m, "00.000" ) & """" )

	/// Each driver's median racing lap per race (Power Query Group By), averaged; shown as m:ss.000.
	measure 'Avg Median Race Pace' = AVERAGE ( 'Race Pace'[Median Lap Sec] )
		displayFolder: Pit Stops & Laps
		lineageTag: 1dac767f-171a-5876-b991-eb7fae5dea08
		formatStringDefinition = VAR _s = SELECTEDMEASURE () VAR _m = INT ( _s / 60 ) RETURN IF ( ISBLANK ( _s ), "0.000", """" & _m & ":" & FORMAT ( _s - 60 * _m, "00.000" ) & """" )

	/// Seconds; the dynamic format string shows it as m:ss.000.
	measure 'Best Lap Time' = MIN ( 'Lap Times'[Lap Seconds] )
		displayFolder: Pit Stops & Laps
		lineageTag: 6b487799-35d5-5676-be45-01a87219e6df
		formatStringDefinition = VAR _s = SELECTEDMEASURE () VAR _m = INT ( _s / 60 ) RETURN IF ( ISBLANK ( _s ), "0.000", """" & _m & ":" & FORMAT ( _s - 60 * _m, "00.000" ) & """" )

	/// Laps completed in first place (lap-time data, 1996 onward).
	measure 'Laps Led' = CALCULATE ( COUNTROWS ( 'Lap Times' ), 'Lap Times'[Lap Position] = 1 )
		formatString: #,0
		displayFolder: Pit Stops & Laps
		lineageTag: 3dd9fdcd-a778-5eb0-8f05-1e2e1d2d6665

	/// Car-adjusted skill: finish-percentile points above an average driver in the same car (0 = average).
	measure 'Car-Adjusted Skill' = AVERAGE ( 'Driver Skill'[Skill Value] )
		formatString: +0.000;-0.000;0.000
		displayFolder: Drivers
		lineageTag: 4e97d435-7fca-509a-b780-02855aa67b2d

	/// Rank of the driver on car-adjusted skill (1 = best).
	measure 'Skill Rank' = MIN ( 'Driver Skill'[Skill Rank Value] )
		formatString: #0
		displayFolder: Drivers
		lineageTag: 57f946f4-3537-5e13-a929-6a492dc6e917

	/// Share of races out-qualifying the team-mate.
	measure 'Quali H2H Win %' = DIVIDE ( SUM ( 'Teammate H2H'[Quali Wins] ), SUM ( 'Teammate H2H'[Races Together] ) )
		formatString: 0%
		displayFolder: Drivers
		lineageTag: 285ea917-4ca8-54df-9066-fd3ee5e1a509

	/// Share of races finishing ahead of the team-mate (mechanical DNFs excluded).
	measure 'Race H2H Win %' = DIVIDE ( SUM ( 'Teammate H2H'[Race Wins] ), SUM ( 'Teammate H2H'[Comparable Races] ) )
		formatString: 0%
		displayFolder: Drivers
		lineageTag: dd39e104-9043-57e0-80f3-198fd124abf1

	/// Average age of drivers at their first Grand Prix.
	measure 'Avg Debut Age' = AVERAGE ( Driver[Debut Age] )
		formatString: #,0.0
		displayFolder: Drivers
		lineageTag: 4a46a336-27ec-5db8-b049-d35b0c095645

	/// Modern-scale points per Grand Prix entered: AVERAGEX over the races in context.
	measure 'Avg Points per Race' = AVERAGEX ( VALUES ( Results[Race Id] ), [Points (Modern Scale)] )
		formatString: #,0.0
		displayFolder: Iterators
		lineageTag: 5b3d3e1d-ee5d-5b66-97c4-dbd596e0c3ad

	/// Wins at a circuit in the driver's own country (RELATED walks Results → Race → Circuit).
	measure 'Home Wins' = COUNTROWS ( FILTER ( Results, Results[Is Win] && RELATED ( Driver[Driver Country] ) = RELATED ( Circuit[Circuit Country] ) ) )
		formatString: #,0
		displayFolder: Iterators
		lineageTag: 612fd70c-1f92-59d1-b222-e82d625c6c39

	/// Wins at circuits in any country of the drivers in context: the Circuit filter reaches Results through its expanded table (Results → Race → Circuit).
	measure 'Wins at Home Circuits' = CALCULATE ( [Wins], TREATAS ( VALUES ( Driver[Driver Country] ), Circuit[Circuit Country] ) )
		formatString: #,0
		displayFolder: Iterators
		lineageTag: 0c52db49-20ca-5151-b5bd-243ee4db0c99

	/// Best single season on the modern scale: MAXX turns each season row into a filter (context transition).
	measure 'Best Season Points' = MAXX ( VALUES ( Season[Year] ), [Points (Modern Scale)] )
		formatString: #,0
		displayFolder: Iterators
		lineageTag: a8fb0c18-a451-53a5-875b-f7886b716fc0

	/// Seasons in which the drivers in context won at least once.
	measure 'Seasons With a Win' = COUNTROWS ( FILTER ( VALUES ( Season[Year] ), [Wins] > 0 ) )
		formatString: #,0
		displayFolder: Iterators
		lineageTag: 2759f788-d8fe-5da0-b0ca-eb9de898a76d

	/// Constructor with the most modern-scale points in the current selection (TOPN over ADDCOLUMNS).
	measure 'Top Team of Selection' =
			VAR _t = TOPN ( 1, ADDCOLUMNS ( VALUES ( Constructor[Constructor Name] ), "@p", [Points (Modern Scale)] ), [@p], DESC )
			RETURN MAXX ( _t, Constructor[Constructor Name] )
		displayFolder: Iterators
		lineageTag: c7b63b43-59ab-5c97-99e0-bc99cdda2b43

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Wins from grid slot 1 or 2. KEEPFILTERS: a grid filter already on the visual is intersected, not replaced.
	measure 'Front Row Wins' = CALCULATE ( [Wins], KEEPFILTERS ( Results[Grid Position] IN { 1, 2 } ) )
		formatString: #,0
		displayFolder: Filter Context
		lineageTag: 3eecb814-dda5-513f-a6de-5f65321cccdc

	/// Wins from grid slot 11 or lower (FILTER over the Results rows in context).
	measure 'Wins From Outside Top 10' = CALCULATE ( [Wins], FILTER ( Results, Results[Grid Position] > 10 ) )
		formatString: #,0
		displayFolder: Filter Context
		lineageTag: 779774ff-1d73-5dd7-a5f5-8af12204c7a6

	/// Share of all wins in the season(s) in context: ALLEXCEPT keeps only the Season filters.
	measure 'Share of Season Wins' = F1.Share ( [Wins], CALCULATE ( [Wins], ALLEXCEPT ( Results, Season ) ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Filter Context
		lineageTag: bf4f38ca-84bb-5f65-bcd2-5a38d1e1ea2f

	/// Share of the wins of the drivers visible in the visual (ALLSELECTED Driver).
	measure '% of Visible Wins' = F1.Share ( [Wins], CALCULATE ( [Wins], ALLSELECTED ( Driver ) ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Filter Context
		lineageTag: b72aac03-1d3a-5fc0-a59f-68287446745b

	/// Podiums from pole; the pole filter REPLACES any filter on Results[Is Pole].
	measure 'Podiums From Pole' = CALCULATE ( [Podiums], Results[Is Pole] = TRUE () )
		formatString: #,0
		displayFolder: Filter Context
		lineageTag: 9e06df0d-4f9f-5a8a-9961-2127a9182595

	/// Podiums from pole; KEEPFILTERS intersects with a filter already on Results[Is Pole].
	measure 'Podiums From Pole (KF)' = CALCULATE ( [Podiums], KEEPFILTERS ( Results[Is Pole] = TRUE () ) )
		formatString: #,0
		displayFolder: Filter Context
		lineageTag: 39650802-ee4b-5a0e-a96b-a840d5651d4f

	/// Team-mates' points minus the driver's, read from the team-mate side: USERELATIONSHIP switches on the inactive Teammate Id → Driver relationship.
	measure 'Teammate Points Delta' = CALCULATE ( SUM ( 'Teammate H2H'[Points Delta] ), USERELATIONSHIP ( 'Teammate H2H'[Teammate Id], Driver[Driver Id] ) )
		formatString: +#,0;-#,0;0
		displayFolder: Filter Context
		lineageTag: 2a8c4ce7-518f-54fc-bd3e-40f3cac03134

	/// Season-to-date modern-scale points (DATESYTD on the marked date table).
	measure 'Points STD' = CALCULATE ( [Points (Modern Scale)], DATESYTD ( 'Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Time Intelligence
		lineageTag: 1369254d-d54c-5816-aa18-2429d31ce2d8

	/// Quarter-to-date modern-scale points.
	measure 'Points QTD' = CALCULATE ( [Points (Modern Scale)], DATESQTD ( 'Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Time Intelligence
		lineageTag: f5e4bfa4-b0ff-5c53-924d-72f2dab350a0

	/// Month-to-date modern-scale points.
	measure 'Points MTD' = CALCULATE ( [Points (Modern Scale)], DATESMTD ( 'Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Time Intelligence
		lineageTag: 02e96a06-32cb-589e-be74-cb1c40e63233

	/// Modern-scale points in the same period one season earlier (Season filters cleared, so a season slicer can shift).
	measure 'Points PY' = CALCULATE ( [Points (Modern Scale)], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ), REMOVEFILTERS ( Season ) )
		formatString: #,0
		displayFolder: Time Intelligence
		lineageTag: d4f2ca30-9a48-5bab-9739-da940aa67bf6

	/// Modern-scale points vs the previous season.
	measure 'Points YoY %' =
			VAR _py = [Points PY]
			RETURN DIVIDE ( [Points (Modern Scale)] - _py, _py )
		formatString: +0%;-0%;0%
		displayFolder: Time Intelligence
		lineageTag: cd3fd2ce-a8ea-5c53-ab92-8ab12a7dcb52

	/// Win rate one season back (DATEADD -1 YEAR).
	measure 'Win Rate Prev Season' = CALCULATE ( [Win Rate], DATEADD ( 'Calendar'[Date], -1, YEAR ), REMOVEFILTERS ( Season ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Time Intelligence
		lineageTag: 66580ec1-eecc-551f-a4e2-f8e30077182c

	/// Same as Win Rate Prev Season with PREVIOUSYEAR: always the whole previous year.
	measure 'Win Rate Prev Season (PREVIOUSYEAR)' = CALCULATE ( [Win Rate], PREVIOUSYEAR ( 'Calendar'[Date] ), REMOVEFILTERS ( Season ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Time Intelligence
		lineageTag: 35fc956c-6b4d-5531-b0c9-e084ffa00176

	/// Wins one season back (UDF F1.PrevSeason, EXPR parameter).
	measure 'Wins Prev Season' = F1.PrevSeason ( [Wins] )
		formatString: #,0
