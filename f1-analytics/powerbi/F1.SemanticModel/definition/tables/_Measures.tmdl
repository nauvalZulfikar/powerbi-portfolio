		lineageTag: 9bdbbfb2-75f4-516e-98f5-77ceaa8571c8

	/// Average of the yearly DNF rates over the five seasons ending in context (DATESINPERIOD -5 YEAR).
	measure 'DNF Rate 5Y Avg' =
			AVERAGEX (
			    CALCULATETABLE ( VALUES ( 'Calendar'[Year] ), DATESINPERIOD ( 'Calendar'[Date], MAX ( 'Calendar'[Date] ), -5, YEAR ), REMOVEFILTERS ( Season ) ),
			    CALCULATE ( [DNF Rate], REMOVEFILTERS ( Season ) ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Time Intelligence
		lineageTag: 197382e0-5831-5b5b-959f-b7f96546e748

	/// Semi-additive: the championship points on the last date with standings (LASTNONBLANKVALUE).
	measure 'Points at Season End' = LASTNONBLANKVALUE ( 'Calendar'[Date], [Championship Points] )
		formatString: #,0.0
