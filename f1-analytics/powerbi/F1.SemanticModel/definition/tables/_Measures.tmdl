	/// Championship points after the previous round (OFFSET -1 over the selected rounds).
	measure 'Points Prev Round' = CALCULATE ( [Championship Points], OFFSET ( -1, ALLSELECTED ( Race[Round] ), ORDERBY ( Race[Round] ) ) )
		formatString: #,0.0
		displayFolder: Window Functions
		lineageTag: 8c9d1561-dc71-5c84-8fa9-fad0bf834ae3

	/// Modern-scale points from round 1 to the current round (WINDOW 1 ABS … 0 REL).
	measure 'Running Points (Window)' = SUMX ( WINDOW ( 1, ABS, 0, REL, ALLSELECTED ( Race[Round] ), ORDERBY ( Race[Round] ) ), [Points (Modern Scale)] )
		formatString: #,0
		displayFolder: Window Functions
		lineageTag: 43e2a6b4-f752-5d74-aa54-4b8765e7767b

	/// Average modern-scale points over the current and two previous rounds.
	measure 'Points 3-Race Avg' = AVERAGEX ( WINDOW ( -2, REL, 0, REL, ALLSELECTED ( Race[Round] ), ORDERBY ( Race[Round] ) ), [Points (Modern Scale)] )
		formatString: #,0.0
		displayFolder: Window Functions
		lineageTag: 0f18f327-e395-5d0b-b4c3-8a6b796e1c07

	/// Dense rank of the driver by wins among the drivers visible in the visual.
	measure 'Season Rank by Wins' = IF ( [Wins] > 0, RANK ( DENSE, ALLSELECTED ( Driver[Driver Name] ), ORDERBY ( [Wins], DESC ) ) )
		formatString: #0
		displayFolder: Window Functions
		lineageTag: 360a8c13-5040-5526-9c46-3294af106e37

	/// Driver with the most wins in the decade(s) in context (INDEX 1 over all drivers).
	measure 'Top Driver of Decade' = MAXX ( INDEX ( 1, ALL ( Driver[Driver Name] ), ORDERBY ( [Wins], DESC, Driver[Driver Name], ASC ) ), Driver[Driver Name] )
		displayFolder: Window Functions
		lineageTag: 5ef85525-2d3d-5518-9361-655f63da25b5

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Selected seasons, for page subtitles.
	measure 'Season Range Label' =
			VAR _a = MIN ( Race[Race Year] ) VAR _b = MAX ( Race[Race Year] )
			RETURN IF ( _a = _b, FORMAT ( _a, "0" ), FORMAT ( _a, "0" ) & "–" & FORMAT ( _b, "0" ) )
		displayFolder: Report UI
		lineageTag: 8e8be2f2-d983-51df-9095-f560ef52a55f

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Drivers' and constructors' champion of the one selected season (text).
	measure 'Champions (driver · team)' = IF ( HASONEVALUE ( Season[Year] ), SELECTEDVALUE ( Season[Champion] ) & " · " & COALESCE ( SELECTEDVALUE ( Season[Constructor Champion] ), "no constructors' title" ), "Select one season" )
		displayFolder: Report UI
		lineageTag: c8e525d5-acab-5f0c-a2d3-fcebcc7f1339

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Winner and pole sitter of the one selected race (text).
	measure 'Race Winner Label' = IF ( HASONEVALUE ( Race[Race Label] ), "Winner: " & SELECTEDVALUE ( Race[Winner] ) & "  ·  Pole: " & SELECTEDVALUE ( Race[Pole Sitter] ), "Select one race" )
		displayFolder: Report UI
