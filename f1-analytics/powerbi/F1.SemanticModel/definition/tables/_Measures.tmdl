	/// The value picked on the 'Win Points' what-if slider (25 = today's system).
	measure 'Win Points Value' = SELECTEDVALUE ( 'Win Points'[Win Points], 25 )
		formatString: #,0
		displayFolder: What-if
		lineageTag: d7f2a031-26a8-51b4-b3bb-cb8ed72e3203

	/// Modern-scale points with a win worth the slider value instead of 25. Not the same as 'Points (Chosen System)', which re-scores every finishing position with a historical system.
	measure 'What-if Points' = [Points (Modern Scale)] + ( [Win Points Value] - 25 ) * [Wins]
		formatString: #,0
		displayFolder: What-if
		lineageTag: e404f41e-d2c6-511e-ba2f-456a82840483

	/// Driver's position in the official standings after the round in context.
	measure 'Championship Position' = MIN ( Standings[Standing Position] )
		formatString: #0
		displayFolder: What-if
		lineageTag: dea173c1-1760-5153-bb59-095458cd7bfd

	/// Fastest race lap on record at the circuit (2004+ timing).
	measure 'Circuit Lap Record' = SELECTEDVALUE ( Circuit[Lap Record], "—" )
		displayFolder: Report UI
		lineageTag: cd276bbb-ad4a-512e-a1ed-8bc902bbf827

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Driver who set the circuit's race lap record.
	measure 'Circuit Lap Record Holder' = SELECTEDVALUE ( Circuit[Lap Record Holder], "—" )
		displayFolder: Report UI
		lineageTag: 5a1f9955-c49b-584d-b69a-f480990d2084

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Dense rank of the driver by wins among all drivers (RANKX), in the seasons in context.
	measure 'Driver Win Rank' = IF ( [Wins] > 0, RANKX ( ALL ( Driver[Driver Name] ), [Wins], , DESC, DENSE ) )
		formatString: #0
		displayFolder: Market
		lineageTag: 3c2d8351-51bc-5403-a03d-8269528d92a0

	/// Pareto: share of all wins held by this driver and every driver ranked at or above (RANKX + SUMX, all drivers, seasons in context).
	measure 'Cumulative Win Share' =
			VAR _r = [Driver Win Rank]
			VAR _t = FILTER ( ADDCOLUMNS ( ALL ( Driver[Driver Name] ), "@w", [Wins] ), [@w] > 0 )
			VAR _ranked = ADDCOLUMNS ( _t, "@r", RANKX ( _t, [@w], , DESC, DENSE ) )
			RETURN IF ( NOT ISBLANK ( _r ), DIVIDE ( SUMX ( FILTER ( _ranked, [@r] <= _r ), [@w] ), SUMX ( _t, [@w] ) ) )
		formatString: 0%
		displayFolder: Market
		lineageTag: 8c7f2c8f-ab60-51b6-9d48-bd0caa4a9508

	/// How many drivers, best first, it takes to reach 80% of the wins in context (drivers tied on wins count together).
	measure 'Drivers for 80% of Wins' =
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( Driver[Driver Name] ), "@w", [Wins] ), [@w] > 0 )
			VAR _tot = SUMX ( _t, [@w] )
			VAR _c = ADDCOLUMNS ( _t, "@above", VAR _x = [@w] RETURN SUMX ( FILTER ( _t, [@w] > _x ), [@w] ) )
			RETURN COUNTROWS ( FILTER ( _c, [@above] < 0.8 * _tot ) )
		formatString: #,0
		displayFolder: Market
		lineageTag: 6b313cd1-b2d4-5f2e-b2d9-9c8969515db3

	/// 'Drivers for 80% of Wins' as a share of every driver who raced in context.
	measure 'Share of Drivers for 80% of Wins' = DIVIDE ( [Drivers for 80% of Wins], [Drivers] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Market
		lineageTag: 674f5288-8816-5aca-955b-d1ed4764b0f5

	/// Constructor's modern-scale points plus every team above it, as a share of all points in the seasons in context.
	measure 'Cumulative Points Share' =
			VAR _p = [Points (Modern Scale)]
			VAR _t = FILTER ( ADDCOLUMNS ( ALL ( Constructor[Constructor Name] ), "@p", [Points (Modern Scale)] ), [@p] > 0 )
			RETURN IF ( _p > 0, DIVIDE ( SUMX ( FILTER ( _t, [@p] >= _p ), [@p] ), SUMX ( _t, [@p] ) ) )
		formatString: 0%
		displayFolder: Market
		lineageTag: 35946b4e-158e-5d49-85bb-fe8882865b7e

	/// Dynamic ABC on modern-scale points, follows the era slicer: A = the teams that make up the first 70% of points, B = the next 20%, C = the last 10% (class set by where the team's slice starts).
	measure 'ABC Class' =
			VAR _cum = [Cumulative Points Share]
			VAR _before = _cum - DIVIDE ( [Points (Modern Scale)], CALCULATE ( [Points (Modern Scale)], REMOVEFILTERS ( Constructor ) ) )
			RETURN IF ( NOT ISBLANK ( _cum ), SWITCH ( TRUE (), _before < 0.7, "A", _before < 0.9, "B", "C" ) )
		displayFolder: Market
		lineageTag: eceda0db-8e73-56a1-afa3-d33a7b536ece

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Drivers who raced in context whose win rate in context falls in the selected 'Win Bands' row (disconnected table).
	measure 'Drivers in Band' =
			VAR _lo = MIN ( 'Win Bands'[Min Win Rate] )
			VAR _hi = MAX ( 'Win Bands'[Max Win Rate] )
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( Driver[Driver Name] ), "@s", [Starts], "@r", COALESCE ( [Win Rate], 0 ) ), [@s] > 0 )
			RETURN COUNTROWS ( FILTER ( _t, ( [@r] >= _lo && [@r] < _hi ) || ( _lo = 0 && [@r] = 0 ) ) ) + 0
		formatString: #,0
		displayFolder: Market
		lineageTag: c9f7d75e-db11-5153-94a7-304989ca0bb3

	/// The seasons the rookie / returning / churn cards count: the selected era or season, or 2023 when nothing narrows the seasons (over all 75 seasons every driver would be a rookie; 2023 is the last season whose leavers are known).
	measure 'Period Counted' =
			VAR _full = MIN ( Season[Year] ) = CALCULATE ( MIN ( Season[Year] ), REMOVEFILTERS ( Season ) )
			    && MAX ( Season[Year] ) = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) )
			VAR _ref = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) ) - 1
			VAR _a = MIN ( Season[Year] ) VAR _b = MAX ( Season[Year] )
			RETURN IF ( _full, FORMAT ( _ref, "0" ) & " (default)", IF ( _a = _b, FORMAT ( _a, "0" ), FORMAT ( _a, "0" ) & "–" & FORMAT ( _b, "0" ) ) )
		displayFolder: Market
		lineageTag: 5383ab70-760a-5bc9-a651-70a790d62c03

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Drivers who raced in the period counted (see 'Period Counted').
	measure 'Drivers in Period' =
			VAR _full = MIN ( Season[Year] ) = CALCULATE ( MIN ( Season[Year] ), REMOVEFILTERS ( Season ) )
			    && MAX ( Season[Year] ) = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) )
			VAR _ref = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) ) - 1
			RETURN IF ( _full,
			    CALCULATE ( [Drivers] + 0, REMOVEFILTERS ( Season ), Season[Year] = _ref ),
			    [Drivers] + 0 )
		formatString: #,0
		displayFolder: Market
		lineageTag: 7b09e8a7-38a3-5a88-b9e6-0a00d14f19eb

	/// Drivers in the period counted whose first season falls inside it.
	measure Rookies =
			VAR _full = MIN ( Season[Year] ) = CALCULATE ( MIN ( Season[Year] ), REMOVEFILTERS ( Season ) )
			    && MAX ( Season[Year] ) = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) )
			VAR _ref = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) ) - 1
			RETURN IF ( _full,
			    CALCULATE ( VAR _s = MIN ( Season[Year] ) RETURN COUNTROWS ( FILTER ( SUMMARIZE ( Results, Driver[Driver Id], Driver[Driver First Season] ), Driver[Driver First Season] >= _s ) ) + 0, REMOVEFILTERS ( Season ), Season[Year] = _ref ),
			    VAR _s = MIN ( Season[Year] ) RETURN COUNTROWS ( FILTER ( SUMMARIZE ( Results, Driver[Driver Id], Driver[Driver First Season] ), Driver[Driver First Season] >= _s ) ) + 0 )
		formatString: #,0
		displayFolder: Market
		lineageTag: 930b936d-9f0f-5178-97cd-8636df47efa0

	/// Drivers in the period counted who had raced before it started.
	measure 'Returning Drivers' = [Drivers in Period] - [Rookies]
		formatString: #,0
		displayFolder: Market
		lineageTag: 9acbd4e3-e231-5760-b12b-e5a4c36a927b

	/// Rookies as a share of all drivers in the selected period.
	measure 'Rookie Share' = DIVIDE ( [Rookies], [Drivers in Period] )
		formatString: 0%
		displayFolder: Market
		lineageTag: da3df357-4770-5181-965a-4acf26ce99b3

	/// Drivers in the period counted whose last season falls inside it (the last data season is excluded: its leavers are not known yet).
	measure 'Drivers Leaving Grid' =
			VAR _full = MIN ( Season[Year] ) = CALCULATE ( MIN ( Season[Year] ), REMOVEFILTERS ( Season ) )
			    && MAX ( Season[Year] ) = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) )
			VAR _ref = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) ) - 1
			RETURN IF ( _full,
			    CALCULATE ( VAR _b = MAX ( Season[Year] ) VAR _last = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) ) RETURN IF ( MIN ( Season[Year] ) < _last, COUNTROWS ( FILTER ( SUMMARIZE ( Results, Driver[Driver Id], Driver[Driver Last Season] ), Driver[Driver Last Season] <= _b && Driver[Driver Last Season] < _last ) ) + 0 ), REMOVEFILTERS ( Season ), Season[Year] = _ref ),
			    VAR _b = MAX ( Season[Year] ) VAR _last = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) ) RETURN IF ( MIN ( Season[Year] ) < _last, COUNTROWS ( FILTER ( SUMMARIZE ( Results, Driver[Driver Id], Driver[Driver Last Season] ), Driver[Driver Last Season] <= _b && Driver[Driver Last Season] < _last ) ) + 0 ) )
		formatString: #,0
		displayFolder: Market
		lineageTag: e333f5e7-d231-54b6-89ba-01c623f60474

	/// Drivers leaving the grid ÷ drivers in the period counted.
	measure 'Churn Rate' = DIVIDE ( [Drivers Leaving Grid], [Drivers in Period] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Market
		lineageTag: a30b3dc7-9c5c-5eff-9be6-9d8bde379df7

	/// Cohort retention: of the drivers in the row's debut cohort, the share who raced N seasons after their debut season (cohorts too recent to observe season N are left out). Ignores the era slicer.
	measure '% Still on Grid' =
			VAR _n = SELECTEDVALUE ( 'Seasons Since Debut'[Seasons Since Debut] )
			VAR _last = CALCULATE ( MAX ( Season[Year] ), REMOVEFILTERS ( Season ) )
			VAR _base = FILTER ( SUMMARIZE ( Driver, Driver[Driver Id], Driver[Driver First Season] ), Driver[Driver First Season] + _n <= _last )
			VAR _kept = FILTER ( _base, VAR _y = Driver[Driver First Season] + _n RETURN CALCULATE ( NOT ISEMPTY ( Results ), REMOVEFILTERS ( Season ), Results[Result Year] = _y ) )
			RETURN IF ( NOT ISBLANK ( _n ), DIVIDE ( COUNTROWS ( _kept ), COUNTROWS ( _base ) ) )
		formatString: 0%
		displayFolder: Market
		lineageTag: e43777c9-93c1-53d7-b78b-fd04f2814d06

	/// Team-seasons with a known next season (row band → column band).
	measure 'Team Moves' = COUNTROWS ( FILTER ( 'Team Season', NOT ISBLANK ( 'Team Season'[Next Band] ) ) )
		formatString: #,0
		displayFolder: Market
		lineageTag: df7b2cd1-08fa-5dc6-8316-68f09f6a9522

	/// Share of the row band's team-seasons that landed in the column band the next season.
	measure 'Transition %' = DIVIDE ( [Team Moves], CALCULATE ( [Team Moves], REMOVEFILTERS ( 'Team Season'[Next Band], 'Team Season'[Next Band Order] ) ) )
		formatString: 0%
		displayFolder: Market
		lineageTag: 8cf3c027-49e7-55e0-a09a-1051bb71b0aa

	/// Race entries reaching each 'Funnel Stage': entered → started → finished → scored points → podium → win; each stage nested in the one before.
	measure 'Funnel Count' =
			SWITCH ( SELECTEDVALUE ( 'Funnel Stage'[Stage Order] ),
			    1, COUNTROWS ( Results ),
			    2, [Starts],
			    3, CALCULATE ( COUNTROWS ( Results ), Results[Is Finished] = TRUE () ),
			    4, CALCULATE ( COUNTROWS ( Results ), Results[Is Finished] = TRUE (), Results[Is Points Finish] = TRUE () ),
			    5, CALCULATE ( COUNTROWS ( Results ), Results[Is Finished] = TRUE (), Results[Is Points Finish] = TRUE (), Results[Is Podium] = TRUE () ),
			    6, CALCULATE ( COUNTROWS ( Results ), Results[Is Finished] = TRUE (), Results[Is Points Finish] = TRUE (), Results[Is Podium] = TRUE (), Results[Is Win] = TRUE () ) )
		formatString: #,0
		displayFolder: Diagnosis
		lineageTag: 0467409f-09e9-5f35-85d1-92297dcc0c64

	/// Funnel stage as a share of all entries.
	measure '% of Entries' = DIVIDE ( [Funnel Count], CALCULATE ( [Funnel Count], REMOVEFILTERS ( 'Funnel Stage' ), 'Funnel Stage'[Stage Order] = 1 ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Diagnosis
		lineageTag: 0a8aa9af-30ac-5d86-9f21-c15a2f2eb7b3

	/// Modern-scale points minus the same filter one season earlier ('Points PY').
	measure 'Points Change vs PY' = [Points (Modern Scale)] - [Points PY]
		formatString: +#,0;-#,0;0
		displayFolder: Diagnosis
		lineageTag: 24fbcaa0-598e-5d50-84e6-7e9257d0625c

	/// DNF rate minus last season's, in percentage points (UDF F1.PrevSeason).
	measure 'DNF Rate Change vs PY' = [DNF Rate] - F1.PrevSeason ( [DNF Rate] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Diagnosis
		lineageTag: 53e3c644-350c-5ebd-b49b-5fb11888a17c

	/// Average grid slot minus last season's: + = starting further back.
	measure 'Avg Grid Change vs PY' = [Avg Grid] - F1.PrevSeason ( [Avg Grid] )
		formatString: +0.0;-0.0;0.0
		displayFolder: Diagnosis
		lineageTag: f9f66341-8f50-5fbd-88b9-8c820e21d66a

	/// Least-squares line through the per-season median pit-lane time (LINESTX over the seasons in the visual).
	measure 'Pit Lane Time Trend' =
			VAR _t = FILTER ( ADDCOLUMNS ( ALLSELECTED ( Season[Year] ), "@v", [Median Pit Lane Time] ), NOT ISBLANK ( [@v] ) )
			VAR _fit = LINESTX ( _t, [@v], Season[Year] )
			RETURN IF ( NOT ISBLANK ( [Median Pit Lane Time] ), MAXX ( _fit, [Intercept] ) + MAXX ( _fit, [Slope1] ) * MAX ( Season[Year] ) )
		formatString: 0.00" s"
		displayFolder: Diagnosis
		lineageTag: 994b7afa-bbec-5c08-803b-a5297e06e1dd

	/// Seconds per season of the LINESTX trend.
	measure 'Pit Lane Time Slope' =
			VAR _t = FILTER ( ADDCOLUMNS ( ALLSELECTED ( Season[Year] ), "@v", [Median Pit Lane Time] ), NOT ISBLANK ( [@v] ) )
			RETURN MAXX ( LINESTX ( _t, [@v], Season[Year] ), [Slope1] )
		formatString: +0.000" s";-0.000" s"
		displayFolder: Diagnosis
		lineageTag: 2d61f6db-f46e-5dcc-bce0-b3fc779176c2

	/// Season leader when every finish is re-scored with the points system picked in 'Points Systems'; 'changed' when it is not the official champion.
	measure 'Re-scored Champion' =
			IF ( HASONEVALUE ( Season[Year] ),
			    VAR _t = ADDCOLUMNS ( SUMMARIZE ( Results, Driver[Driver Name], Driver[Surname] ), "@p", [Points (Chosen System)] )
			    VAR _top = TOPN ( 1, _t, [@p], DESC )
			    RETURN CONCATENATEX ( _top, Driver[Surname], " / " ) & IF ( COUNTROWS ( FILTER ( _top, Driver[Driver Name] = SELECTEDVALUE ( Season[Champion] ) ) ) > 0, " · unchanged", " · changed" ),
			    "Select one season" )
		displayFolder: Diagnosis
		lineageTag: 189882e9-232c-5d6f-b83b-9e72a88d0c56

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Season leader on 'What-if Points' (modern scale, a win worth the slider value); 'changed' when it is not the official champion.
	measure 'What-if Champion' =
			IF ( HASONEVALUE ( Season[Year] ),
			    VAR _t = ADDCOLUMNS ( SUMMARIZE ( Results, Driver[Driver Name], Driver[Surname] ), "@p", [What-if Points] )
			    VAR _top = TOPN ( 1, _t, [@p], DESC )
			    RETURN CONCATENATEX ( _top, Driver[Surname], " / " ) & IF ( COUNTROWS ( FILTER ( _top, Driver[Driver Name] = SELECTEDVALUE ( Season[Champion] ) ) ) > 0, " · unchanged", " · changed" ),
			    "Select one season" )
		displayFolder: Diagnosis
		lineageTag: 82e529ea-ad10-5828-aff0-f534790c9adc

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Diverging colour for car-adjusted skill.
	measure 'Skill Color' =
			VAR _s = [Car-Adjusted Skill]
			RETURN SWITCH ( TRUE (), ISBLANK ( _s ), "#383835", _s >= 0.08, "#3987E5", _s >= 0, "#86B6EF", _s > -0.08, "#F19A99", "#E66767" )
		displayFolder: Report UI
		lineageTag: 89b18b90-58c1-553b-ab51-26838b8b20f3

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cef922bf-b16f-5a2f-b8bb-349878cf5acd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = {1}
