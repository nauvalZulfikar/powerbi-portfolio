		lineageTag: 55599e3c-b175-5f0c-bc49-79e750c1d693

	/// Season-to-date on the calendar 'F1 Calendar' (calendar-based time intelligence).
	measure 'Points STD (Cal)' = TOTALYTD ( [Points (Modern Scale)], 'F1 Calendar' )
		formatString: #,0
		displayFolder: Time Intelligence
		lineageTag: 20594f1e-94f9-56e1-bf24-145e631ea7e2

	/// Season-to-date wins (UDF F1.SeasonToDate).
	measure 'Wins STD' = F1.SeasonToDate ( [Wins], 'F1 Calendar' )
