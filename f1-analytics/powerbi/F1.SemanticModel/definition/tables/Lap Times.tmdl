	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 30
		incrementalGranularity: year
		incrementalPeriods: 1
		sourceExpression =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_lap_times.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"race_id", Int64.Type}, {"driver_id", Int64.Type}, {"lap", Int64.Type}, {"position", Int64.Type}, {"lap_seconds", type number}, {"is_pit_lap", type logical}, {"race_date", type date}}),
				    InRange = Table.SelectRows(Typed, each DateTime.From([race_date]) >= RangeStart and DateTime.From([race_date]) < RangeEnd)
				in
				    InRange

	partition 'Lap Times' = m
		mode: import
		source =
