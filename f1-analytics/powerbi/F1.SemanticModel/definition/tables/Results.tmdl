	partition Results = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_results.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"result_id", Int64.Type}, {"race_id", Int64.Type}, {"driver_id", Int64.Type}, {"constructor_id", Int64.Type}, {"circuit_id", Int64.Type}, {"year", Int64.Type}, {"round", Int64.Type}, {"grid", Int64.Type}, {"grid_band", type text}, {"grid_band_order", Int64.Type}, {"finish_position", Int64.Type}, {"position_order", Int64.Type}, {"field_size", Int64.Type}, {"points", type number}, {"points_modern", Int64.Type}, {"laps", Int64.Type}, {"status", type text}, {"status_group", type text}, {"is_finished", type logical}, {"is_dnf", type logical}, {"is_mechanical_dnf", type logical}, {"is_win", type logical}, {"is_podium", type logical}, {"is_pole", type logical}, {"is_points_finish", type logical}, {"is_fastest_lap", type logical}, {"positions_gained", Int64.Type}, {"finish_percentile", type number}, {"fastest_lap_ms", Int64.Type}, {"fastest_lap_kph", type number}}),
				    InRange = Table.SelectRows(Typed, each #datetime([year], 1, 1, 0, 0, 0) >= RangeStart and #datetime([year], 1, 1, 0, 0, 0) < RangeEnd)
				in
				    InRange

