<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="SalesPipeline">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=powerbi://api.powerbi.com/v1.0/myorg/Sales Pipeline [Prod];Initial Catalog=SalesPipeline</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="StaleByAgent">
      <Query>
        <DataSourceName>SalesPipeline</DataSourceName>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS (
    Agent[Manager],
    Agent[Sales Agent],
    "Stale Deals", [Stale Deals],
    "Stale Pipeline", [Stale Pipeline],
    "Open Deals", [Open Deals]
)
ORDER BY Agent[Manager], [Stale Pipeline] DESC</CommandText>
      </Query>
      <Fields><Field Name="Manager"><DataField>Agent[Manager]</DataField></Field><Field Name="Sales_Agent"><DataField>Agent[Sales Agent]</DataField></Field><Field Name="Open_Deals"><DataField>[Open Deals]</DataField></Field><Field Name="Stale_Deals"><DataField>[Stale Deals]</DataField></Field><Field Name="Stale_Pipeline"><DataField>[Stale Pipeline]</DataField></Field></Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Stale deals by manager</Value>
              <Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph>
            <Paragraph><TextRuns><TextRun><Value>Engaging deals older than 104 days at the last sync. For the monthly pipeline review.</Value>
              <Style><FontSize>9pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
            <Top>0in</Top><Left>0in</Left><Height>0.7in</Height><Width>7.8in</Width><Style /></Textbox>
          <Tablix Name="StaleTable">
            <TablixBody>
              <TablixColumns><TablixColumn><Width>2.2in</Width></TablixColumn><TablixColumn><Width>2.2in</Width></TablixColumn><TablixColumn><Width>1in</Width></TablixColumn><TablixColumn><Width>1in</Width></TablixColumn><TablixColumn><Width>1.4in</Width></TablixColumn></TablixColumns>
              <TablixRows>
                <TablixRow><Height>0.3in</Height><TablixCells><TablixCell><CellContents><Textbox Name="h_Manager"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Manager</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Sales_Agent"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Sales Agent</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Open_Deals"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Open Deals</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Stale_Deals"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Stale Deals</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Stale_Pipeline"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Stale Pipeline</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.3in</Height><TablixCells><TablixCell><CellContents><Textbox Name="t_Manager"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Manager.Value</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="t_Sales_Agent"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value></Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="t_Open_Deals"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Open_Deals.Value)</Value><Style><FontWeight>Bold</FontWeight><Format>#,0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="t_Stale_Deals"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Stale_Deals.Value)</Value><Style><FontWeight>Bold</FontWeight><Format>#,0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="t_Stale_Pipeline"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Stale_Pipeline.Value)</Value><Style><FontWeight>Bold</FontWeight><Format>$#,0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                <TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="d_Manager"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value></Value><Style></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Sales_Agent"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Sales_Agent.Value</Value><Style></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Open_Deals"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Open_Deals.Value</Value><Style><Format>#,0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Stale_Deals"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Stale_Deals.Value</Value><Style><Format>#,0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Stale_Pipeline"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Stale_Pipeline.Value</Value><Style><Format>$#,0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Color>LightGrey</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember>
                <TablixMember>
                  <Group Name="Manager"><GroupExpressions><GroupExpression>=Fields!Manager.Value</GroupExpression></GroupExpressions>
                    <PageBreak><BreakLocation>Between</BreakLocation></PageBreak></Group>
                  <SortExpressions><SortExpression><Value>=Fields!Manager.Value</Value></SortExpression></SortExpressions>
