{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "name": "bm_stale",
  "displayName": "Stale only",
  "options": {
    "applyOnlyToTargetVisuals": true,
    "targetVisualNames": [
      "grp_stale",
      "grp_open",
      "table_stale_agents",
      "table_open_agents"
    ],
    "suppressData": true,
    "suppressActiveSection": false
  },
  "explorationState": {
    "version": "1.3",
    "activeSection": "pipeline",
    "sections": {
      "pipeline": {
        "visualContainers": {
          "table_stale_agents": {},
          "table_open_agents": {
            "singleVisual": {
              "display": {
                "mode": "hidden"
              }
            }
          }
        },
        "visualContainerGroups": {
          "grp_stale": {
            "isHidden": false
          },
          "grp_open": {
            "isHidden": true
          }
        }
      }
    }
  }
}
