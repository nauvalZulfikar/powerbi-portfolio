	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 3
		incrementalGranularity: month
		incrementalPeriods: 15
		pollingExpression =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_opportunity.parquet")),
				    Data = Source,
				    InRange = Table.SelectRows(Data, each DateTime.From([created_date]) >= RangeStart and DateTime.From([created_date]) < RangeEnd),
				    LastChange = List.Max(InRange[modified_at])
				in
				    LastChange
		sourceExpression =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_opportunity.parquet")),
				    Data = Source,
				    Kept = Table.RemoveColumns(Data, {"modified_at"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"opportunity_id", type text}, {"owner_id", type text}, {"account_id", type text}, {"product_id", type text}, {"stage_key", type text}, {"created_date", type date}, {"engaged_date", type date}, {"closed_date", type date}, {"close_value", type number}, {"list_price", type number}, {"open_value", type number}, {"price_realisation", type number}, {"cycle_days", Int64.Type}, {"cycle_band", type text}, {"age_days", Int64.Type}, {"age_band", type text}, {"has_account", type logical}}),
				    InRange = Table.SelectRows(Typed, each DateTime.From([created_date]) >= RangeStart and DateTime.From([created_date]) < RangeEnd)
				in
				    InRange

	partition Opportunities = m
		mode: import
		source =
