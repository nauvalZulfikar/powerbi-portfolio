table 'Pipeline Snapshots'
	lineageTag: 13838513-8b3b-5c65-b2e4-4ad46c60c1ec

	column 'Snapshot Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 3d8ce510-1e88-5726-ad0a-af3cdec92509
		summarizeBy: none
		sourceColumn: snapshot_date

	column 'Opportunity ID'
		dataType: string
		isHidden
		lineageTag: 29c9db93-bfa2-5c71-a6f1-53767155c586
		summarizeBy: none
		sourceColumn: opportunity_id

	column 'Owner ID'
		dataType: string
		isHidden
		lineageTag: 4c2f6269-8ca2-5abc-9c00-01f2b809ebbb
		summarizeBy: none
		sourceColumn: owner_id

	column 'Account ID'
		dataType: string
		isHidden
		lineageTag: d9e2b8d1-84db-56d8-a947-1d4606c3decd
		summarizeBy: none
		sourceColumn: account_id

	column 'Product ID'
		dataType: string
		isHidden
		lineageTag: e7a844e7-33ef-5490-9a91-231df1b80898
		summarizeBy: none
		sourceColumn: product_id

	column 'Stage Key'
		dataType: string
		isHidden
		lineageTag: 4c28d4f8-5f5f-5b72-9653-cc4d314e491d
		summarizeBy: none
		sourceColumn: stage_key

	column 'Snapshot Age Days'
