		lineageTag: 5d8bb239-0b38-5c9d-a83c-67d89916012f
		summarizeBy: none
		sourceColumn: age_band

	column 'Snapshot Open Value'
		dataType: double
		formatString: \$#,0;(\$#,0);\$0
		lineageTag: 24bc7de4-d599-55fc-b173-00529a810dae
		summarizeBy: none
		sourceColumn: open_value

	column 'Snapshot Close Value'
		dataType: double
		formatString: \$#,0;(\$#,0);\$0
		lineageTag: bf556a34-c80d-5c7e-a9bf-d82d6988c78f
		summarizeBy: none
		sourceColumn: close_value

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 3
		incrementalGranularity: month
		incrementalPeriods: 1
		sourceExpression =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_pipeline_snapshot.parquet")),
				    Data = Source,
				    Typed = Table.TransformColumnTypes(Data, {{"snapshot_date", type date}, {"opportunity_id", type text}, {"owner_id", type text}, {"account_id", type text}, {"product_id", type text}, {"stage_key", type text}, {"age_days", Int64.Type}, {"age_band", type text}, {"open_value", type number}, {"close_value", type number}}),
				    InRange = Table.SelectRows(Typed, each DateTime.From([snapshot_date]) >= RangeStart and DateTime.From([snapshot_date]) < RangeEnd)
				in
				    InRange

	partition 'Pipeline Snapshots' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_pipeline_snapshot.parquet")),
				    Data = Source,
				    Typed = Table.TransformColumnTypes(Data, {{"snapshot_date", type date}, {"opportunity_id", type text}, {"owner_id", type text}, {"account_id", type text}, {"product_id", type text}, {"stage_key", type text}, {"age_days", Int64.Type}, {"age_band", type text}, {"open_value", type number}, {"close_value", type number}}),
				    InRange = Table.SelectRows(Typed, each DateTime.From([snapshot_date]) >= RangeStart and DateTime.From([snapshot_date]) < RangeEnd)
				in
				    InRange

	annotation PBI_ResultType = Table
