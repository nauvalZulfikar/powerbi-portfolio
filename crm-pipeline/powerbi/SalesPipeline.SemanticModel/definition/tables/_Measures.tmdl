table _Measures
	lineageTag: 3930af6e-37bc-50a8-af0d-e61d61573249

	/// Opportunities in the current filter.
	measure Deals = COUNTROWS ( Opportunities )
		formatString: #,0
		displayFolder: Deals
		lineageTag: 33dd6575-ed11-51b3-aa07-c2ed9f5d09a3

	/// Deals closed as won.
	measure 'Won Deals' = CALCULATE ( [Deals], Opportunities[Stage Key] = "closedwon" )
		formatString: #,0
		displayFolder: Deals
		lineageTag: b39152a4-2459-57d2-ae4c-5b459238b092

	/// Deals closed as lost.
	measure 'Lost Deals' = CALCULATE ( [Deals], Opportunities[Stage Key] = "closedlost" )
		formatString: #,0
		displayFolder: Deals
		lineageTag: 9745c83b-f6b0-5163-a789-7d5b960fffb7

	/// Won plus lost deals.
	measure 'Closed Deals' = [Won Deals] + [Lost Deals]
		formatString: #,0
		displayFolder: Deals
		lineageTag: ffa151c2-b9bf-501f-8741-013b2649ed94

	/// Won ÷ closed (won + lost). Open deals are not counted.
	measure 'Win Rate' = Kpi.Rate ( [Won Deals], [Closed Deals] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Deals
		lineageTag: 1c4ffaee-417e-5d48-ab17-c5e9e903cdd1

	/// Close value of won deals.
	measure 'Won Revenue' = CALCULATE ( SUM ( Opportunities[Close Value] ), Opportunities[Stage Key] = "closedwon" )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Deals
		lineageTag: ed94b464-1975-51da-be2e-990b24aa4833

	/// Won revenue with a dynamic format string: $1.23M, $45K or $678 depending on size.
	measure 'Won Revenue Compact' = [Won Revenue]
		displayFolder: Deals
		lineageTag: b1681992-2ab5-57ae-a136-b0827436b8da
		formatStringDefinition = SWITCH ( TRUE (), ABS ( SELECTEDMEASURE () ) >= 1e6, "$#,0.00,,""M""", ABS ( SELECTEDMEASURE () ) >= 1e3, "$#,0,""K""", "$#,0" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING","MEASURES_SHOULD_NOT_BE_DIRECT_REFERENCES_OF_OTHER_MEASURES"]}

	/// Won revenue per won deal.
	measure 'Avg Deal Size' = Kpi.Rate ( [Won Revenue], [Won Deals] )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Deals
		lineageTag: aef8be63-5f11-5e33-954a-23fa2f7913fa

	/// Average days from engage to close, closed deals only.
	measure 'Avg Cycle Days' = AVERAGE ( Opportunities[Cycle Days] )
		formatString: #,0
		displayFolder: Deals
		lineageTag: 81570b8e-3a3a-5930-91a0-a8b683781aaf

	/// Won revenue ÷ list price of the products sold. Above 100% = sold over list.
	measure 'Price Realisation' = Kpi.Rate ( [Won Revenue], CALCULATE ( SUM ( Opportunities[List Price] ), Opportunities[Stage Key] = "closedwon" ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Deals
		lineageTag: 83549d51-813b-5660-90d1-2c4d09eda37d

	/// Share of won revenue across everything in the visual.
	measure 'Revenue Share' = DIVIDE ( [Won Revenue], CALCULATE ( [Won Revenue], ALLSELECTED () ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Deals
		lineageTag: a2860ffe-61f7-5e9c-8a87-ca6e84042069

	/// The measure picked in the Metric field parameter; its format string follows the pick.
	measure 'Selected Metric' =
			SWITCH ( SELECTEDVALUE ( Metric[Metric Order], 0 ),
			    0, [Won Revenue],
			    1, [Win Rate],
			    2, [Avg Deal Size],
			    3, [Avg Cycle Days],
			    4, [Deals]
			)
		displayFolder: Deals
		lineageTag: 3e188ced-2886-58a6-b597-3a328ff25333
		formatStringDefinition = SWITCH ( SELECTEDVALUE ( Metric[Metric Order], 0 ), 1, "0.0%", 3, "0", 4, "#,0", "\$#,0" )

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// List price minus close value, summed over won deals (SUMX, row by row).
	measure 'Discount Leakage' = SUMX ( FILTER ( Opportunities, Opportunities[Stage Key] = "closedwon" ), Opportunities[List Price] - Opportunities[Close Value] )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Deals
		lineageTag: 6102e85f-319c-583e-a0a2-a00d17100657

	/// Catalogue list price of every won deal, read from Product with RELATED.
	measure 'Catalog Value Won' = SUMX ( FILTER ( Opportunities, Opportunities[Stage Key] = "closedwon" ), RELATED ( Product[List Price] ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Deals
		lineageTag: e09c84ae-116a-519e-b3b5-943613bec7d3

	/// Won revenue from deals larger than the average won deal in the current filter (FILTER inside CALCULATE).
	measure 'Above-Average Deal Revenue' =
			VAR _avg = [Avg Deal Size]
			RETURN
			    CALCULATE ( [Won Revenue], FILTER ( Opportunities, Opportunities[Close Value] > _avg ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Deals
		lineageTag: 338f7b6f-360f-5858-a304-3632a39ea4cd

	/// Won revenue from Large (5k+) accounts. KEEPFILTERS intersects with a Size Band slicer instead of overriding it.
	measure 'Won Revenue Large Accounts' = CALCULATE ( [Won Revenue], KEEPFILTERS ( Account[Size Band] = "Large (5k+)" ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Deals
		lineageTag: 26b440f7-5ee4-5093-bc36-5388f93418c3

	/// Accounts with at least one won deal (DISTINCTCOUNT), excluding the no-account row.
	measure 'Active Accounts' = CALCULATE ( DISTINCTCOUNT ( Opportunities[Account ID] ), Opportunities[Stage Key] = "closedwon", Opportunities[Has Account] = TRUE () )
		formatString: #,0
		displayFolder: Accounts
		lineageTag: 0b44a2c9-c05a-56e3-8054-7cb8c708e32e

	/// Accounts with any deal in the filter: Opportunities as a CALCULATE filter carries its expanded table to Account.
	measure 'Accounts Touched' = CALCULATE ( COUNTROWS ( Account ), Opportunities )
		formatString: #,0
		displayFolder: Accounts
		lineageTag: 8bbc4ad0-612a-5f70-84b7-b2522ba19ca5

	/// Won revenue averaged over the accounts in the filter (AVERAGEX).
	measure 'Avg Revenue per Account' = AVERAGEX ( VALUES ( Account[Account] ), [Won Revenue] )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Accounts
		lineageTag: d8402103-130f-58bd-a23a-e67cfd294a34

	/// Won revenue of the ten largest accounts among those selected (TOPN).
	measure 'Top 10 Accounts Revenue' = CALCULATE ( [Won Revenue], TOPN ( 10, ALLSELECTED ( Account[Account] ), [Won Revenue], DESC ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Accounts
		lineageTag: cf49ca81-0d33-583d-808b-cd16ff7ac3f4

	/// Pareto: won revenue of this account and every larger one, as a share of all selected accounts (WINDOW).
	measure 'Account Cumulative Share' =
			VAR _cum = CALCULATE ( [Won Revenue], WINDOW ( 1, ABS, 0, REL, ALLSELECTED ( Account[Account] ), ORDERBY ( [Won Revenue], DESC, Account[Account], ASC ) ) )
			RETURN
			    IF ( NOT ISBLANK ( [Won Revenue] ), DIVIDE ( _cum, CALCULATE ( [Won Revenue], ALLSELECTED ( Account[Account] ) ) ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Accounts
		lineageTag: dec6e50e-d76f-5a0e-9d07-85db09814fd4

	/// A = accounts making the first 80% of won revenue in the current selection, B = the next 15%, C = the rest.
	measure 'Account ABC' =
			VAR _rev = [Won Revenue]
			VAR _accounts = ADDCOLUMNS ( ALLSELECTED ( Account[Account] ), "@rev", [Won Revenue] )
			VAR _total = SUMX ( _accounts, [@rev] )
			VAR _cum = SUMX ( FILTER ( _accounts, [@rev] >= _rev ), [@rev] )
			VAR _share = DIVIDE ( _cum, _total )
			RETURN
			    IF ( HASONEVALUE ( Account[Account] ) && _rev > 0,
			        SWITCH ( TRUE (), _share <= 0.8, "A", _share <= 0.95, "B", "C" ) )
		displayFolder: Accounts
		lineageTag: b6abdb47-29d5-537f-a574-661ca6f1e70d

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Pareto: how many accounts make the first 80% of won revenue in the selection.
	measure 'Accounts to 80%' = COUNTROWS ( FILTER ( ALLSELECTED ( Account[Account] ), VAR _s = [Account Cumulative Share] RETURN NOT ISBLANK ( _s ) && _s <= 0.8 ) )
		formatString: #,0
		displayFolder: Accounts
		lineageTag: 29d0cdac-13f2-5229-b2d7-646fa783022a

	/// Accounts to 80% as a share of the accounts with won revenue in the selection.
	measure 'Share of Accounts to 80%' = Kpi.Rate ( [Accounts to 80%], COUNTROWS ( FILTER ( ALLSELECTED ( Account[Account] ), [Won Revenue] > 0 ) ) )
		formatString: 0%
		displayFolder: Accounts
		lineageTag: f7222a01-1425-5057-accc-e149cb620aa9

	/// Accounts whose won revenue in the current filter falls inside the Account Segment band.
	measure 'Accounts in Segment' =
			VAR _lo = MIN ( 'Account Segment'[Low] )
			VAR _hi = MAX ( 'Account Segment'[High] )
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( Account[Account] ), VAR _r = [Won Revenue] RETURN _r > 0 && _r >= _lo && _r < _hi ) )
		formatString: #,0
		displayFolder: Accounts
		lineageTag: 88514017-baa8-5419-9123-039da2e3b35a

	/// Won revenue of the accounts inside the Account Segment band.
	measure 'Segment Revenue' =
			VAR _lo = MIN ( 'Account Segment'[Low] )
			VAR _hi = MAX ( 'Account Segment'[High] )
			RETURN
			    SUMX ( FILTER ( VALUES ( Account[Account] ), VAR _r = [Won Revenue] RETURN _r > 0 && _r >= _lo && _r < _hi ), [Won Revenue] )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Accounts
		lineageTag: 044db9c7-0590-5c1e-ae2c-3f1e2f2bd307

	/// Won revenue one quarter back on the Gregorian calendar.
	measure 'Won Revenue PQ' = Kpi.PriorQuarter ( [Won Revenue], 'Gregorian' )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Variance
		lineageTag: c0075433-eeec-5f5b-971d-3539c340443a

	/// Won revenue minus won revenue one quarter back.
	measure 'Revenue Change QoQ' = [Won Revenue] - [Won Revenue PQ]
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Variance
		lineageTag: fcfaf93e-e6ac-5391-96fd-e8e5c53140e1

	/// Won revenue minus won revenue one month back (calendar-based, no axis needed).
	measure 'Revenue Change MoM' = [Won Revenue] - [Revenue Last Month]
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Variance
		lineageTag: 4fbed80b-6f73-55be-9d07-89040baf6b40

	/// Part of the QoQ change from winning more or fewer deals at last quarter's mix and prices.
	measure 'Volume Effect' =
			VAR _qc = CALCULATE ( [Won Deals], ALLSELECTED ( Product ) )
			VAR _qp = Kpi.PriorQuarter ( CALCULATE ( [Won Deals], ALLSELECTED ( Product ) ), 'Gregorian' )
			RETURN
			    SUMX ( VALUES ( Product[Product] ),
			        VAR _np = Kpi.PriorQuarter ( [Won Deals], 'Gregorian' )
			        VAR _pp = Kpi.PriorQuarter ( [Avg Deal Size], 'Gregorian' )
			        RETURN ( _qc - _qp ) * DIVIDE ( _np, _qp ) * _pp )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Variance
		lineageTag: 3aac285d-bc85-55f4-9da8-c9e9c5c649fb

	/// Part of the QoQ change from selling a different product mix, at last quarter's prices.
	measure 'Mix Effect' =
			VAR _qc = CALCULATE ( [Won Deals], ALLSELECTED ( Product ) )
			VAR _qp = Kpi.PriorQuarter ( CALCULATE ( [Won Deals], ALLSELECTED ( Product ) ), 'Gregorian' )
			RETURN
			    SUMX ( VALUES ( Product[Product] ),
			        VAR _nc = [Won Deals]
			        VAR _np = Kpi.PriorQuarter ( [Won Deals], 'Gregorian' )
			        VAR _pp = Kpi.PriorQuarter ( [Avg Deal Size], 'Gregorian' )
			        RETURN _qc * ( DIVIDE ( _nc, _qc ) - DIVIDE ( _np, _qp ) ) * _pp )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Variance
		lineageTag: 330bbb31-ea67-5d51-8487-a1c37459dbf4

	/// Part of the QoQ change from a different average deal size per product.
	measure 'Price Effect' =
			SUMX ( VALUES ( Product[Product] ),
			    VAR _nc = [Won Deals]
			    VAR _pc = [Avg Deal Size]
			    VAR _pp = Kpi.PriorQuarter ( [Avg Deal Size], 'Gregorian' )
			    RETURN _nc * ( _pc - _pp ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Variance
		lineageTag: 0b36f026-2318-530f-83d9-516d9fa47c21

	/// Revenue Change QoQ minus volume, mix and price effects; zero when the bridge closes.
	measure 'Bridge Check' = [Revenue Change QoQ] - [Volume Effect] - [Mix Effect] - [Price Effect]
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Variance
		lineageTag: 8af61ad0-0678-5817-84e2-3cd19b7b678b

	/// 90th percentile of engage-to-close days over the closed deals in the filter (PERCENTILEX.INC).
	measure 'P90 Cycle Days' = PERCENTILEX.INC ( FILTER ( Opportunities, NOT ISBLANK ( Opportunities[Cycle Days] ) ), Opportunities[Cycle Days], 0.9 )
		formatString: #,0
		displayFolder: Outliers
		lineageTag: 9e1852fd-77b0-5ce1-ba6d-b7bfd9522e09

	/// How many standard deviations an agent's stale share sits from the average agent in the selection; above 2 = outlier.
	measure 'Agent Stale Z-Score' =
			VAR _s = IF ( [Open Pipeline] > 0, COALESCE ( [Stale Share], 0 ) )
			VAR _agents = ADDCOLUMNS ( FILTER ( ALLSELECTED ( Agent[Sales Agent] ), [Open Pipeline] > 0 ), "@s", COALESCE ( [Stale Share], 0 ) )
			VAR _mu = AVERAGEX ( _agents, [@s] )
			VAR _sd = STDEVX.P ( _agents, [@s] )
			RETURN
			    IF ( HASONEVALUE ( Agent[Sales Agent] ) && NOT ISBLANK ( _s ), DIVIDE ( _s - _mu, _sd ) )
		formatString: +0.00;-0.00;0.00
		displayFolder: Outliers
		lineageTag: 9a40147f-ddb7-50cd-a9cb-4f91396212bb

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Linear trend of monthly won revenue (LINESTX); months after the last sync are a projection, not a forecast with seasonality.
	measure 'Revenue Trend Forecast' =
			VAR _pts = CALCULATETABLE (
			    FILTER ( ADDCOLUMNS ( VALUES ( 'Date'[Month Start] ), "@x", YEAR ( 'Date'[Month Start] ) * 12 + MONTH ( 'Date'[Month Start] ), "@y", [Won Revenue] ), NOT ISBLANK ( [@y] ) ),
			    REMOVEFILTERS ( 'Date' ) )
			VAR _fit = LINESTX ( _pts, [@y], [@x] )
			VAR _m = MAX ( 'Date'[Month Start] )
			RETURN
			    IF ( HASONEVALUE ( 'Date'[Month Start] ) && COUNTROWS ( _pts ) >= 3 && _m >= MINX ( _pts, 'Date'[Month Start] ),
			        MAXX ( _fit, [Intercept] ) + MAXX ( _fit, [Slope1] ) * ( YEAR ( _m ) * 12 + MONTH ( _m ) ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Outliers
		lineageTag: 96fbc8c5-fcca-578f-b20b-655b8f252306

	/// Win rate of the whole region of the agent or manager in the row (ALLEXCEPT).
	measure 'Region Win Rate' = CALCULATE ( [Win Rate], ALLEXCEPT ( Agent, Agent[Region] ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Team
		lineageTag: 3474826e-a81e-55fe-a6e2-3119ffc70e6c

	/// Win rate minus the win rate of the region it belongs to.
	measure 'Win Rate vs Region' = [Win Rate] - [Region Win Rate]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Team
		lineageTag: 468dab07-12e0-5c4f-8c12-5d6491760ec7

	/// Font colour for Win Rate vs Region: green above the region, red below.
	measure 'Win Rate vs Region Color' =
			VAR _d = [Win Rate vs Region]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _d ), BLANK (), _d >= 0, "#1E7B34", "#B42318" )
		displayFolder: Team
		lineageTag: 3c77ed80-180c-575f-ba7a-92611944b459

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Deals on the Stage Flow link in the row: Created → Engaged / still prospecting, Engaged → Won / Lost / still engaging.
	measure 'Flow Deals' =
			SWITCH ( SELECTEDVALUE ( 'Stage Flow'[To] ),
			    "Engaged", CALCULATE ( [Deals], NOT ISBLANK ( Opportunities[Engaged Date] ) ),
			    "Still prospecting", CALCULATE ( [Deals], Opportunities[Stage Key] = "prospecting" ),
			    "Won", [Won Deals],
			    "Lost", [Lost Deals],
			    "Still engaging", CALCULATE ( [Deals], Opportunities[Stage Key] = "engaging" )
			)
		formatString: #,0
		displayFolder: Flow
		lineageTag: 7c39648a-e6a9-542b-b353-826818d92cf5

	/// Deals that went from the From Stage at the previous month-end sync to the To Stage at this one.
	measure 'Transition Deals' = COUNTROWS ( 'Stage Transitions' )
		formatString: #,0
		displayFolder: Flow
		lineageTag: 93d269f0-e476-537e-97df-fba36297d146

	/// Deals still open at the last sync. Ignores date filters.
	measure 'Open Deals' = CALCULATE ( [Deals], Opportunities[Stage Key] IN { "engaging", "prospecting" }, REMOVEFILTERS ( 'Date' ) )
		formatString: #,0
		displayFolder: Pipeline
		lineageTag: 15011b65-c124-5ab7-9059-73cfb138413d

	/// List value of open deals (no amount exists until a deal closes).
	measure 'Open Pipeline' = CALCULATE ( SUM ( Opportunities[Open Value] ), REMOVEFILTERS ( 'Date' ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Pipeline
		lineageTag: 7162b4a0-0183-5a5d-883f-4f17b1de80c9

	/// Selected Stale Threshold; default = P90 Cycle Days over all closed deals (104).
	measure 'Stale Days' = SELECTEDVALUE ( 'Stale Threshold'[Stale Threshold], ROUND ( CALCULATE ( [P90 Cycle Days], REMOVEFILTERS () ), 0 ) )
		formatString: #,0
		displayFolder: Pipeline
		lineageTag: 61b6133d-c37e-5cd9-b200-0389d8859559

	/// Engaging deals older than the stale threshold.
	measure 'Stale Deals' =
			VAR _t = [Stale Days]
			RETURN
			    CALCULATE ( [Deals], Opportunities[Stage Key] = "engaging", Opportunities[Age Days] > _t, REMOVEFILTERS ( 'Date' ) )
		formatString: #,0
		displayFolder: Pipeline
		lineageTag: 7325ac8a-302c-5972-b402-205b70aed586

	/// List value of engaging deals older than the stale threshold.
	measure 'Stale Pipeline' =
			VAR _t = [Stale Days]
			RETURN
			    CALCULATE ( SUM ( Opportunities[Open Value] ), Opportunities[Stage Key] = "engaging", Opportunities[Age Days] > _t, REMOVEFILTERS ( 'Date' ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Pipeline
		lineageTag: 5f5e3ff0-4d5a-5d57-b992-e6859b325f8b

	/// Share of open pipeline value that is stale.
	measure 'Stale Share' = Kpi.Rate ( [Stale Pipeline], [Open Pipeline] )
		formatString: 0%
		displayFolder: Pipeline
		lineageTag: ea01b911-f225-5acc-82aa-abcd5bd98a4d

	/// Open pipeline minus stale deals.
	measure 'Live Pipeline' = [Open Pipeline] - [Stale Pipeline]
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Pipeline
		lineageTag: 8ab3f6e9-5772-5ff2-a74c-e7aac1a067ef

	/// Selected Win Probability; defaults to the historical win rate.
	measure 'Forecast Win Rate' = SELECTEDVALUE ( 'Win Probability'[Win Probability], CALCULATE ( [Win Rate], REMOVEFILTERS ( 'Date', Stage ) ) )
		formatString: 0%
		displayFolder: Pipeline
		lineageTag: ff5001fc-7ce9-5038-866f-e2280fa9d46e

	/// Live pipeline × forecast win rate × historical price realisation. Stale deals are assumed lost.
	measure 'Weighted Forecast' = [Live Pipeline] * [Forecast Win Rate] * CALCULATE ( [Price Realisation], REMOVEFILTERS ( 'Date', Stage ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Pipeline
		lineageTag: bf61fc86-fb06-54bc-aa5c-2c4de720d5b9

	/// Open deals not linked to any account: a CRM hygiene gap.
	measure 'Open Without Account' = CALCULATE ( [Deals], Opportunities[Stage Key] IN { "engaging", "prospecting" }, Opportunities[Has Account] = FALSE (), REMOVEFILTERS ( 'Date' ) )
		formatString: #,0
		displayFolder: Pipeline
		lineageTag: 995f4754-41ce-5c62-965c-14bf138a8a8b

	/// Open list value at the latest snapshot in the filter.
	measure 'Snapshot Open Pipeline' =
			VAR _d = MAX ( 'Pipeline Snapshots'[Snapshot Date] )
			RETURN
			    CALCULATE (
			        SUM ( 'Pipeline Snapshots'[Snapshot Open Value] ),
			        'Pipeline Snapshots'[Snapshot Date] = _d
			    )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Snapshots
		lineageTag: 2be70215-570f-5413-8f4e-740e2b1d3804

	/// Open deals at the latest snapshot in the filter.
	measure 'Snapshot Open Deals' =
			VAR _d = MAX ( 'Pipeline Snapshots'[Snapshot Date] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Pipeline Snapshots' ),
			        'Pipeline Snapshots'[Snapshot Date] = _d,
			        'Pipeline Snapshots'[Stage Key] IN { "engaging", "prospecting" }
			    )
		formatString: #,0
		displayFolder: Snapshots
		lineageTag: 204a49b2-e5c2-5817-9371-2174649e95b0

	/// Engaging value older than the stale threshold at that snapshot.
	measure 'Snapshot Stale Pipeline' =
			VAR _t = [Stale Days]
			VAR _d = MAX ( 'Pipeline Snapshots'[Snapshot Date] )
			RETURN
			    CALCULATE (
			        SUM ( 'Pipeline Snapshots'[Snapshot Open Value] ),
			        'Pipeline Snapshots'[Snapshot Date] = _d,
			        'Pipeline Snapshots'[Stage Key] = "engaging",
			        'Pipeline Snapshots'[Snapshot Age Days] > _t
			    )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Snapshots
		lineageTag: 13367652-8c60-522d-bace-6744b2fb28e7

	/// Stale share of open value at the latest snapshot in the filter.
	measure 'Snapshot Stale Share' = Kpi.Rate ( [Snapshot Stale Pipeline], [Snapshot Open Pipeline] )
		formatString: 0%
		displayFolder: Snapshots
		lineageTag: b5724517-df5c-57af-8fcc-60652fd5c08a

	/// Deals that reached the step.
	measure 'Funnel Deals' = COUNTROWS ( Funnel )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: d404664b-e800-5467-97d1-1f743ac26472

	/// Funnel deals ÷ deals created.
	measure 'Share of Created' = Kpi.Rate ( [Funnel Deals], CALCULATE ( [Funnel Deals], Funnel[Step Sort] = 1 ) )
		formatString: 0%
		displayFolder: Funnel
		lineageTag: 67b8d3f0-a364-536d-8117-c371bb9e6ec3

	/// Deals at this step ÷ deals at the step before it (window function OFFSET).
	measure 'Step Conversion' =
			VAR _prev = CALCULATE ( [Funnel Deals], OFFSET ( -1, ALLSELECTED ( Steps[Step], Steps[Step Order] ), ORDERBY ( Steps[Step Order], ASC ) ) )
			RETURN
			    Kpi.Rate ( [Funnel Deals], _prev )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Funnel
		lineageTag: ef0d0088-5ac3-5917-95a3-89c8a3e8fc0b

	/// List value of the deals that reached the step: Steps filters Opportunities through the Funnel bridge (many-to-many).
	measure 'Value Reaching Step' = CALCULATE ( SUM ( Opportunities[List Price] ), CROSSFILTER ( Funnel[Opportunity ID], Opportunities[Opportunity ID], BOTH ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Funnel
		lineageTag: b9dd5bb5-2c69-53cd-af45-35342d483dfb

	/// Average list price of the deals that reached the step (many-to-many).
	measure 'Avg Value Reaching Step' = CALCULATE ( AVERAGE ( Opportunities[List Price] ), CROSSFILTER ( Funnel[Opportunity ID], Opportunities[Opportunity ID], BOTH ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Funnel
		lineageTag: 8a94ac7a-2955-5c0c-86d0-c36aa00ac233

	/// Won revenue one month back on the Gregorian calendar (calendar-based time intelligence).
	measure 'Revenue Last Month' = Kpi.PriorMonth ( [Won Revenue], 'Gregorian' )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Trends
		lineageTag: 4152c4b9-bccc-5cd2-901b-ece5c1ba7c05

	/// Won revenue of the previous month on the visual's axis (window function OFFSET).
	measure 'Prev Month Revenue' = CALCULATE ( [Won Revenue], OFFSET ( -1, ALLSELECTED ( 'Date'[Month Start] ), ORDERBY ( 'Date'[Month Start], ASC ) ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Trends
		lineageTag: a1837b01-4c35-5dd5-b453-d1b8b1f62a7c

	/// Won revenue change against the previous month on the axis.
	measure 'MoM Change' =
			VAR _prev = [Prev Month Revenue]
			RETURN
			    Kpi.Rate ( [Won Revenue] - _prev, _prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Trends
		lineageTag: 933c5b7d-38e7-5571-a106-143009449009

	/// Won revenue of this month and the two before it (window function WINDOW).
	measure 'Rolling 3M Revenue' = CALCULATE ( [Won Revenue], WINDOW ( -2, REL, 0, REL, ALLSELECTED ( 'Date'[Month Start] ), ORDERBY ( 'Date'[Month Start], ASC ) ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Trends
		lineageTag: e3229802-c1b1-5984-8b8e-0a4ac85c12d4

	/// Won revenue of the best month among those selected (window function INDEX).
	measure 'Best Month Revenue' = CALCULATE ( [Won Revenue], INDEX ( 1, ALLSELECTED ( 'Date'[Month Start] ), ORDERBY ( [Won Revenue], DESC ) ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Trends
		lineageTag: 059b5b4f-cf77-57b5-b796-d50f35feb1e0

	/// Name of the best month by won revenue (window function INDEX).
	measure 'Best Month' = FORMAT ( MAXX ( INDEX ( 1, ALLSELECTED ( 'Date'[Month Start] ), ORDERBY ( [Won Revenue], DESC ) ), 'Date'[Month Start] ), "mmm yyyy" )
		displayFolder: Trends
		lineageTag: 6dbd1d30-03d2-5f36-b363-fdf0f619f777

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Won revenue as a share of the level above in the Sales Team hierarchy: agent of manager, manager of region, region of total.
	measure 'Share of Parent' =
			SWITCH (
			    TRUE (),
			    ISINSCOPE ( Agent[Sales Agent] ), Kpi.ShareOf ( [Won Revenue], Agent[Sales Agent] ),
			    ISINSCOPE ( Agent[Manager] ), Kpi.ShareOf ( [Won Revenue], Agent[Manager] ),
			    ISINSCOPE ( Agent[Region] ), Kpi.ShareOf ( [Won Revenue], Agent[Region] ),
			    1
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Trends
		lineageTag: 0e71977a-ced9-502c-9752-381fafe49e9b

	/// Win rate in this segment ÷ win rate of every other closed deal in the visual; 1.20 = 20% more likely to win.
	measure 'Win Rate Lift' = Kpi.Lift ( [Won Deals], [Closed Deals], CALCULATE ( [Won Deals], ALLSELECTED () ), CALCULATE ( [Closed Deals], ALLSELECTED () ) )
		formatString: 0.00
		displayFolder: Drivers
		lineageTag: b8a0ef1e-ab34-530d-9873-dada2dca4a9e

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Extraction runs in the filter.
	measure 'Sync Count' = COUNTROWS ( 'Sync Runs' )
		formatString: #,0
		displayFolder: Sync
		lineageTag: fc8c474d-1d6e-5a3a-a0a6-c1683f28e6cc

	/// HTTP requests sent to the CRM API.
	measure 'API Requests' = SUM ( 'Sync Runs'[Requests] )
		formatString: #,0
		displayFolder: Sync
		lineageTag: b20fd6e4-dcc4-5d29-9eb5-c0e3c40ea5c4

	/// Requests that were retried after a 429 or 5xx.
	measure 'API Retries' = SUM ( 'Sync Runs'[Retries] )
		formatString: #,0
		displayFolder: Sync
		lineageTag: cb14b242-ff84-51d0-bf3b-50a3b726ce66

	/// 429 responses (rate limit), retried after Retry-After.
	measure 'Throttled Requests' = SUM ( 'Sync Runs'[Rate Limited 429] )
		formatString: #,0
		displayFolder: Sync
		lineageTag: 31ca2115-a467-5ac8-85ea-5d8d7e4b39f8

	/// 5xx responses, retried with backoff.
	measure 'Server Error Responses' = SUM ( 'Sync Runs'[Server Errors 5xx] )
		formatString: #,0
		displayFolder: Sync
		lineageTag: 88205d01-c151-50d5-879a-2fe6679b2052

	/// Deal versions appended to the raw history.
	measure 'Deal Versions Loaded' = SUM ( 'Sync Runs'[Versions Added] )
		formatString: #,0
		displayFolder: Sync
		lineageTag: 59fd3685-2a76-55fa-bbc5-56fdfda12c3a

	/// Date of the latest extraction run.
	measure 'Last Sync' = MAX ( 'Sync Runs'[Sync Date] )
		formatString: dd mmm yyyy
		displayFolder: Sync
		lineageTag: f57e1bd3-ef1d-5928-a89c-45c1e26362b0

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// API responses per run and outcome (Sync Run Events, unpivoted in Power Query).
	measure 'Run Responses' = SUM ( 'Sync Run Events'[Value] )
		formatString: #,0
		displayFolder: Sync
		lineageTag: 7da0ecb7-0495-5825-9657-d1b5e04373d9

	/// Stages where the mart's deal count or close value differs from the seed CSV.
	measure 'Reconciliation Gaps' = COUNTROWS ( FILTER ( 'Source Reconciliation', 'Source Reconciliation'[Deals Diff] <> 0 || 'Source Reconciliation'[Value Diff] <> 0 ) )
		formatString: #,0
		displayFolder: Data Trust
		lineageTag: b92c3c5c-42fe-5392-a32b-e5d9c53718a5

	/// Won revenue of the managers listed in the RLS access table, applied to Agent with TREATAS (no relationship).
	measure 'Revenue Covered by RLS' = CALCULATE ( [Won Revenue], KEEPFILTERS ( TREATAS ( VALUES ( 'Manager Access'[Manager] ), Agent[Manager] ) ) )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: Data Trust
		lineageTag: 2943384e-6435-5401-a74a-0fa5e4b4b733

	/// Share of won revenue whose manager has a row in the RLS access table.
	measure 'RLS Coverage' = Kpi.Rate ( [Revenue Covered by RLS], [Won Revenue] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Data Trust
		lineageTag: 6e57a622-13c6-59de-a681-0672e257c1e2

	/// Agents whose first.last login differs from the model email, or whose manager has no RLS row.
	measure 'Login Mismatches' = COUNTROWS ( FILTER ( 'Agent Login Check', NOT 'Agent Login Check'[Email Matches] || NOT 'Agent Login Check'[Manager In RLS Table] ) )
		formatString: #,0
		displayFolder: Data Trust
		lineageTag: 8e8f63f0-3270-5419-9795-5304d8a0a3ae

	/// One-sentence summary that follows the slicers.
	measure Headline =
			VAR _w = [Won Revenue]
			VAR _r = [Win Rate]
			VAR _s = [Stale Share]
			RETURN
			    "Won " & Fmt.Money ( _w ) & " at a " & FORMAT ( _r, "0%" ) & " win rate. "
			        & FORMAT ( [Stale Deals], "#,0" ) & " of " & FORMAT ( [Open Deals], "#,0" )
			        & " open deals are older than " & [Stale Days] & " days, holding " & FORMAT ( _s, "0%" ) & " of the open pipeline."
		displayFolder: Narrative
		lineageTag: 7650a325-49fe-5353-a92b-48e1abe63cd2

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ea2899fa-63b9-5516-a622-6ada41439748
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = {1}
