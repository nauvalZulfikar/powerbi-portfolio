	column 'Is Subsidiary'
		dataType: boolean
		lineageTag: 4b3bfb2b-b969-594d-bc3c-7ff87b2654af
		summarizeBy: none
		sourceColumn: is_subsidiary

	column Employees
		dataType: int64
		formatString: #,0
		lineageTag: 656ddb5f-42fe-57c5-8aca-c20c62d68067
		summarizeBy: none
		sourceColumn: employees

	column 'Annual Revenue'
		dataType: double
		formatString: \$#,0;(\$#,0);\$0
		lineageTag: 3e5a79ab-af22-548d-aa19-9f220adf6a10
		summarizeBy: none
		sourceColumn: annual_revenue

	column 'Founded Year'
		dataType: int64
		formatString: 0
		lineageTag: af1a4a70-3ec4-5300-ab4f-08f9859a389f
		summarizeBy: none
		sourceColumn: founded_year

	column 'Size Band'
		dataType: string
		lineageTag: 759e62c7-22fd-516a-9e43-ecbe2475ad92
		summarizeBy: none
		sourceColumn: size_band
		sortByColumn: 'Size Sort'

	column 'Size Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8117eb73-20c7-5c29-8b18-6f5ff705330d
		summarizeBy: none
		sourceColumn: size_sort

	column 'Lifetime Won Revenue' = CALCULATE ( [Won Revenue] )
		dataType: double
		formatString: \$#,0;(\$#,0);\$0
		lineageTag: 75572499-e9e2-53a9-b227-fdd78c527b71
		summarizeBy: none

	column 'Deal Count' = COUNTROWS ( RELATEDTABLE ( Opportunities ) )
		dataType: int64
		formatString: #,0
		lineageTag: beffd655-19a2-5295-bc7d-0b4c49b324ff
		summarizeBy: none

	column 'Static ABC' =
			VAR _rev = Account[Lifetime Won Revenue]
			VAR _total = SUMX ( FILTER ( Account, Account[Account ID] <> "0" ), Account[Lifetime Won Revenue] )
			VAR _cum = SUMX ( FILTER ( Account, Account[Account ID] <> "0" && Account[Lifetime Won Revenue] >= _rev ), Account[Lifetime Won Revenue] )
			VAR _share = DIVIDE ( _cum, _total )
			RETURN
			    SWITCH ( TRUE (), Account[Account ID] = "0", "n/a", _rev = 0, "C", _share <= 0.8, "A", _share <= 0.95, "B", "C" )
		dataType: string
		lineageTag: 324f4dde-5bd4-5cef-8291-d2c97bd8a1e2
		summarizeBy: none

	partition Account = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dim_account.parquet")),
				    Data = Source,
				    Typed = Table.TransformColumnTypes(Data, {{"account_id", type text}, {"account", type text}, {"sector", type text}, {"country", type text}, {"parent_company", type text}, {"is_subsidiary", type logical}, {"employees", Int64.Type}, {"annual_revenue", type number}, {"founded_year", Int64.Type}, {"size_band", type text}, {"size_sort", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
