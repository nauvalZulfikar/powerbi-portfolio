table 'Source Reconciliation'
	lineageTag: ece2680a-b017-5b0e-a418-d380dceee170

	column Source
		dataType: string
		lineageTag: 222b9d57-db88-52f7-8a42-000cf7850881
		summarizeBy: none
		sourceColumn: Source

	column Stage
		dataType: string
		lineageTag: 265a55d7-971c-5285-a0f1-19846a1549fe
		summarizeBy: none
		sourceColumn: Stage
		sortByColumn: 'Stage Sort'

	column 'Stage Sort'
		dataType: int64
		lineageTag: 3eb09ac2-9d2a-5d7c-b3ae-f183044cd917
		summarizeBy: none
		sourceColumn: Stage Sort
		isHidden
		formatString: 0

