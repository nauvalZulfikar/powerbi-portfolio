	partition 'Snapshot Agg' = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlEndpoint, LakehouseDb),
				    Data = Source{[Schema = "dbo", Item = "fact_pipeline_snapshot"]}[Data],
				    Grouped = Table.Group(Data, {"snapshot_date", "owner_id", "stage_key", "age_band"}, {
				        {"open_value", each List.Sum([open_value]), type number},
				        {"close_value", each List.Sum([close_value]), type number},
				        {"rows", each Table.RowCount(_), Int64.Type}})
				in
