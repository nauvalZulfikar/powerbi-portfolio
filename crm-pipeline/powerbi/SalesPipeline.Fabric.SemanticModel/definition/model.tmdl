model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Date
ref table Account
ref table Product
ref table Agent
ref table Stage
ref table 'Cycle Band'
ref table 'Age Band'
ref table Opportunities
ref table 'Pipeline Snapshots'
ref table Funnel
ref table 'Stage Transitions'
ref table 'Sync Runs'
ref table 'Manager Access'
ref table 'Snapshot Agg'
ref table 'Sync Run Events'
ref table Steps
ref table 'Stale Threshold'
ref table 'Win Probability'
ref table 'Stage Flow'
ref table 'Account Segment'
ref table 'Analyze By'
ref table Metric
ref table 'Date Basis'
ref table 'Time Intelligence'
ref table _Measures

ref role 'Sales Manager'
ref role 'West Region'
ref role 'External Partner'

ref perspective Sales
ref perspective 'Data Ops'

ref cultureInfo en-US
