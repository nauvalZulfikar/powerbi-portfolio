                  {
                    "value": "How the extract works",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Reference objects (owners, companies, products) reload in full. Deals are pulled with a modified-since search from the last watermark, and every new version is kept, so the warehouse can rebuild the pipeline as it stood at each sync.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "429 responses wait for Retry-After; 5xx responses back off exponentially; other 4xx fail fast. Power BI then refreshes incrementally: only partitions whose latest modified date changed.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              }
            ]
