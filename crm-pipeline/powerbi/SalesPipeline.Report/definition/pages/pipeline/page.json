{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "pipeline",
  "displayName": "Pipeline Health",
  "displayOption": "FitToPage",
  "width": 1600,
  "height": 900,
  "filterConfig": {
    "filters": [
      {
        "name": "open_only",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Stage"
              }
            },
            "Property": "Is Open"
          }
        },
        "type": "Categorical",
        "howCreated": "User",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "t",
              "Entity": "Stage",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "t"
                          }
                        },
                        "Property": "Is Open"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "true"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        },
        "isLockedInViewMode": true
      }
    ]
  },
  "visualInteractions": [
    {
      "source": "col_age",
      "target": "table_stale_agents",
      "type": "DataFilter"
    },
    {
      "source": "col_age",
      "target": "table_open_agents",
      "type": "DataFilter"
    },
    {
      "source": "col_age",
      "target": "kpi_0",
      "type": "NoFilter"
    },
    {
      "source": "col_age",
      "target": "kpi_1",
      "type": "NoFilter"
    },
    {
      "source": "col_age",
      "target": "kpi_2",
      "type": "NoFilter"
    },
    {
      "source": "col_age",
      "target": "kpi_3",
      "type": "NoFilter"
    },
    {
      "source": "col_age",
      "target": "kpi_4",
      "type": "NoFilter"
    },
    {
      "source": "col_age",
      "target": "kpi_5",
      "type": "NoFilter"
    }
  ],
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'canvas.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "canvas.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0.0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#E9E8E3'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
