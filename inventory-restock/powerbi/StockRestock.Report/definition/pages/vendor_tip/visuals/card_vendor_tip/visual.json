{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "card_vendor_tip",
  "position": {
    "x": 0,
    "y": 0,
    "z": 0,
    "width": 320,
    "height": 240,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "multiRowCard",
    "objects": {
      "dataLabels": [
        {
          "properties": {
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#0b0b0b'"
                    }
                  }
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "14.0D"
                }
              }
            }
          }
        }
      ],
      "categoryLabels": [
        {
          "properties": {
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#6F6D68'"
                    }
                  }
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "9.0D"
                }
              }
            }
          }
        }
      ],
      "card": [
        {
          "properties": {
            "barShow": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "barColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#2f7d62'"
                    }
                  }
                }
              }
            },
            "barWeight": {
              "expr": {
                "Literal": {
                  "Value": "3.0D"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "border": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Lead time P90, freight share, payment days and shipments for the hovered vendor.'"
                }
              }
            }
          }
        }
      ],
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Values": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Vendor"
                    }
                  },
                  "Property": "Vendor"
                }
              },
              "queryRef": "Vendor.Vendor",
              "nativeQueryRef": "Vendor"
            },
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Vendor"
                    }
                  },
                  "Property": "Lead Days P90"
                }
              },
              "queryRef": "Vendor.Lead Days P90",
              "nativeQueryRef": "Lead Days P90"
            },
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Vendor"
                    }
                  },
                  "Property": "Freight Pct"
                }
              },
              "queryRef": "Vendor.Freight Pct",
              "nativeQueryRef": "Freight Pct"
            },
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Vendor"
                    }
                  },
                  "Property": "Avg Days To Pay"
                }
              },
              "queryRef": "Vendor.Avg Days To Pay",
              "nativeQueryRef": "Avg Days To Pay"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Vendor Shipments"
                }
              },
              "queryRef": "_Measures.Vendor Shipments",
              "nativeQueryRef": "Vendor Shipments"
            }
          ]
        }
      }
    }
  }
}
