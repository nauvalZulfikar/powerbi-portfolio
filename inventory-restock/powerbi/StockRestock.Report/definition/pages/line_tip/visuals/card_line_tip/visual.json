{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "card_line_tip",
  "position": {
    "x": 0,
    "y": 0,
    "z": 0,
    "width": 320,
    "height": 240,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "multiRowCard",
    "objects": {
      "dataLabels": [
        {
          "properties": {
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#0b0b0b'"
                    }
                  }
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "14.0D"
                }
              }
            }
          }
        }
      ],
      "categoryLabels": [
        {
          "properties": {
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#6F6D68'"
                    }
                  }
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "9.0D"
                }
              }
            }
          }
        }
      ],
      "card": [
        {
          "properties": {
            "barShow": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "barColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#2f7d62'"
                    }
                  }
                }
              }
            },
            "barWeight": {
              "expr": {
                "Literal": {
                  "Value": "3.0D"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "border": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Safety stock, reorder point and units to order for the hovered vendor.'"
                }
              }
            }
          }
        }
      ],
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Values": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Vendor"
                    }
                  },
                  "Property": "Vendor"
                }
              },
              "queryRef": "Vendor.Vendor",
              "nativeQueryRef": "Vendor"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Safety Stock Units"
                }
              },
              "queryRef": "_Measures.Safety Stock Units",
              "nativeQueryRef": "Safety Stock Units"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Reorder Point Units"
                }
              },
              "queryRef": "_Measures.Reorder Point Units",
              "nativeQueryRef": "Reorder Point Units"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Units To Order"
                }
              },
              "queryRef": "_Measures.Units To Order",
              "nativeQueryRef": "Units To Order"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Lines To Order"
                }
              },
              "queryRef": "_Measures.Lines To Order",
              "nativeQueryRef": "Lines To Order"
            }
          ]
        }
      }
    }
  }
}
