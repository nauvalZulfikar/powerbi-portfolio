{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "name": "health_pack",
  "displayName": "By pack size",
  "explorationState": {
    "version": "1.3",
    "activeSection": "health",
    "sections": {
      "health": {
        "visualContainers": {
          "matrix_product": {
            "singleVisual": {
              "visualType": "pivotTable"
            }
          },
          "table_abc": {
            "singleVisual": {
              "visualType": "tableEx",
              "display": {
                "mode": "hidden"
              }
            }
          }
        }
      }
    }
  },
  "options": {
    "suppressData": true,
    "applyOnlyToTargetVisuals": true,
    "targetVisualNames": [
      "matrix_product",
      "table_abc"
    ]
  }
}
