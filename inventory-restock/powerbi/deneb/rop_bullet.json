{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bullet per store for one item (Item Detail drillthrough): grey = order-up-to level, green = units on hand, orange tick = reorder point. Top 15 stores by order-up-to level.",
  "data": {"name": "dataset"},
  "transform": [
    {"window": [{"op": "row_number", "as": "rank"}], "sort": [{"field": "Order Up To Units", "order": "descending"}]},
    {"filter": "datum.rank <= 15"}
  ],
  "encoding": {
    "y": {"field": "Store Name", "type": "nominal", "title": null,
          "sort": {"field": "Order Up To Units", "order": "descending"}},
    "tooltip": [
      {"field": "Store Name", "type": "nominal"},
      {"field": "Units On Hand", "type": "quantitative", "format": ",.0f"},
      {"field": "Reorder Point Units", "type": "quantitative", "format": ",.0f"},
      {"field": "Order Up To Units", "type": "quantitative", "format": ",.0f"}
    ]
  },
  "layer": [
    {"mark": {"type": "bar", "color": "#E6E4DD", "height": {"band": 0.8}},
     "encoding": {"x": {"field": "Order Up To Units", "type": "quantitative", "title": "Units"}}},
    {"mark": {"type": "bar", "color": "#2f7d62", "height": {"band": 0.4}},
     "encoding": {"x": {"field": "Units On Hand", "type": "quantitative"}}},
    {"mark": {"type": "tick", "color": "#C2410C", "thickness": 3, "size": 18},
     "encoding": {"x": {"field": "Reorder Point Units", "type": "quantitative"}}}
  ],
  "config": {"view": {"stroke": null}, "axis": {"labelColor": "#52514e", "titleColor": "#52514e", "gridColor": "#ECEBE6",
             "domainColor": "#E6E4DD", "labelFont": "Segoe UI", "labelFontSize": 10}}
}
