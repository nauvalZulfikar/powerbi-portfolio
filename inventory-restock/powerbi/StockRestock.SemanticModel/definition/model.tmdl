model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Date
ref table Store
ref table Vendor
ref table Item
ref table Status
ref table 'Cover Band'
ref table ABC
ref table Stock
ref table 'Daily Sales'
ref table Receipts
ref table Invoices
ref table 'Forecast Daily'
ref table 'Forecast Scores'
ref table 'Weekday Profile'
ref table 'Item Supplier'
ref table Shipments
ref table 'Store Access'
ref table 'Category Target'
ref table 'Stock Counts'
ref table 'Vendor Catalog'
ref table 'Forecast Metric'
ref table 'Service Level'
ref table 'Bridge Step'
ref table 'Funnel Step'
ref table 'Review Period'
ref table 'Time Intelligence'
ref table 'Analyze By'
ref table Metric
ref table _Measures

ref role 'Store Manager'
ref role 'Hornsey District'
ref role 'Store Staff'

ref perspective Restock
ref perspective Purchasing
ref perspective Demand

ref cultureInfo en-US
