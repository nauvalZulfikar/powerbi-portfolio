	column 'Volume ml'
		dataType: string
		lineageTag: fd6c8d51-96fa-5915-85cc-60efbb34fb74
		summarizeBy: none
		sourceColumn: volume_ml

	column Category
		dataType: string
		lineageTag: ae428921-93c2-54e5-98bf-245336e0a747
		summarizeBy: none
		sourceColumn: category

	column 'Vendor No'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d8bbf1a7-4898-5b80-befa-0bdba92674f5
		summarizeBy: none
		sourceColumn: vendor_no

	column 'Retail Price'
		dataType: double
		formatString: \$#,0.00
		lineageTag: 7843b0f9-3235-5771-abe5-1a4d692a3b0e
		summarizeBy: none
		sourceColumn: retail_price

	column 'Item Unit Cost'
		dataType: double
		formatString: \$#,0.00
		lineageTag: a61dc039-61f2-5fe0-8239-ba9b067234f8
		summarizeBy: none
		sourceColumn: unit_cost

	column 'Item Sales 2016'
		dataType: double
		formatString: \$#,0;(\$#,0);\$0
		lineageTag: 94850701-9e5b-5767-98cc-482f82cb2db2
		summarizeBy: none
		sourceColumn: sales_value_2016

	column 'Item ABC'
		dataType: string
		isHidden
		lineageTag: 608bc353-b8e9-5865-aa9c-85d4f0cf171e
		summarizeBy: none
		sourceColumn: abc

	column 'List Price 2017'
		dataType: double
		formatString: \$#,0.00
		lineageTag: acb9e8a0-e343-5a06-a891-1cc05cb8b481
		summarizeBy: none
		sourceColumn: list_price_2017

	column 'Pack Units'
		dataType: int64
		formatString: 0
		lineageTag: 95dcb23e-f990-58cb-8fee-9a5b1beefe75
		summarizeBy: none
		sourceColumn: pack_units

	column 'Pack Size' =
			VAR _ml = IFERROR ( VALUE ( Item[Volume ml] ), BLANK () )
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( _ml ), "Unknown",
			        _ml <= 200, "Miniature",
			        _ml <= 500, "Half bottle",
			        _ml <= 750, "750 mL",
			        _ml <= 1000, "Litre",
			        _ml <= 1750, "1.5–1.75 L",
			        "Large format" )
		dataType: string
		lineageTag: b56e9065-6e32-5364-bf4d-e664617e2647
		summarizeBy: none
		sortByColumn: 'Pack Size Order'

	column 'Pack Size Order' =
			VAR _ml = IFERROR ( VALUE ( Item[Volume ml] ), BLANK () )
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( _ml ), 6,
			        _ml <= 200, 0,
			        _ml <= 500, 1,
			        _ml <= 750, 2,
			        _ml <= 1000, 3,
			        _ml <= 1750, 4,
			        5 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 53864683-c5f4-54dc-9f67-a0d8b197a1c9
		summarizeBy: none

	column 'Retail Price Tier' = IF ( ISBLANK ( Item[Retail Price] ), BLANK (), INT ( Item[Retail Price] / 10 ) * 10 )
		dataType: double
		formatString: \$#,0;(\$#,0);\$0
		lineageTag: 76a1ecf8-4ca7-5b81-84da-04fb481589ae
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
				  "groupedColumns": [
				    {
				      "Column": {
				        "Expression": {
				          "SourceRef": {
				            "Entity": "Item"
				          }
				        },
				        "Property": "Retail Price"
				      }
				    }
				  ],
				  "binningMetadata": {
				    "binSize": {
				      "value": 10.0,
				      "unit": 0
				    }
				  }
				}

	hierarchy Product
		lineageTag: 282e6d99-9bc4-5d70-a5fb-91124df6d9cc

		level Category
			lineageTag: a204d0ee-ffa3-59f2-b0fb-bba133248805
			column: Category

		level 'Pack Size'
			lineageTag: 399f3baa-80bc-57f7-8bdd-f1c9a58248d5
			column: 'Pack Size'

		level Item
			lineageTag: e1503b09-5a31-5654-bf25-84298e8a2909
			column: Item

	partition Item = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dim_item.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"brand", Int64.Type}, {"description", type text}, {"size", type text}, {"volume_ml", type text}, {"category", type text}, {"vendor_no", Int64.Type}, {"retail_price", type number}, {"unit_cost", type number}, {"sales_value_2016", type number}, {"abc", type text}}),
				    // Merge queries: shelf price and pack units from the Dec 2017 price list (left outer join on the brand)
				    #"Merged price list" = Table.NestedJoin(Typed, {"brand"}, #"Price List 2017", {"Brand No"}, "Price List", JoinKind.LeftOuter),
				    #"Expanded price list" = Table.ExpandTableColumn(#"Merged price list", "Price List", {"List Price", "Pack Units"}, {"list_price_2017", "pack_units"})
				in
				    #"Expanded price list"

	annotation PBI_ResultType = Table
