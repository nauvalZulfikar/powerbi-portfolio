table Item
	lineageTag: 46a29635-b304-5b47-bba1-9aef04a4a499

	column 'Brand No'
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 36201c78-9848-5096-8dc8-26d7950fa553
		summarizeBy: none
		sourceColumn: brand

	column Item
