	partition Invoices = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_po.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"po_number", Int64.Type}, {"vendor_no", Int64.Type}, {"po_date", type date}, {"invoice_date", type date}, {"pay_date", type date}, {"units", Int64.Type}, {"dollars", type number}, {"freight", type number}, {"freight_pct", type number}, {"days_to_pay", Int64.Type}, {"approved", type logical}, {"po_matches_receipts", type logical}})
				in
				    Typed

	annotation PBI_ResultType = Table
