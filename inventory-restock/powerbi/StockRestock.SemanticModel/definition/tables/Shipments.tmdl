	partition Shipments = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_shipment.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"vendor_no", Int64.Type}, {"store", Int64.Type}, {"lead_days", Int64.Type}, {"shipments", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
