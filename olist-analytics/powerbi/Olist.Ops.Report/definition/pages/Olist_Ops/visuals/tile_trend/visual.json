{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "tile_trend",
  "position": {
    "x": 24,
    "y": 220,
    "z": 1000,
    "width": 760,
    "height": 480,
    "tabOrder": 200
  },
  "visual": {
    "visualType": "lineChart",
    "objects": {},
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue per month'"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Line chart: Revenue per month'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Month Start"
                }
              },
              "queryRef": "Date.Month Start",
              "nativeQueryRef": "Month Start"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Revenue"
                }
              },
              "queryRef": "_Measures.Revenue",
              "nativeQueryRef": "Revenue"
            }
          ]
        }
      }
    }
  }
}
