	lineageTag: 321c8247-a9ca-59b7-b3dd-ce7fa73f88fe

	annotation PBI_ResultType = Table

/// Both plan years stacked (Append). Staging only: the plan tables reference it.
expression 'Plan Raw' =
		let
		    // Append: same columns in both years
		    Source = Table.Combine({#"Plan 2017", #"Plan 2018"})
		in
		    Source
	lineageTag: f3ab7d93-55c9-5524-96d5-606af25779d8

	annotation PBI_ResultType = Table

/// Distinct category groups from the product mart, with a short code: the lookup the plan is merged to.
expression 'Plan Groups' =
		let
		    Source = Parquet.Document(File.Contents(DataFolder & "dim_product.parquet")),
		    // Only the group column (Parquet reads just this)
		    #"Kept group" = Table.SelectColumns(Source, {"category_group"}),
		    // One row per group
		    #"Distinct groups" = Table.Distinct(#"Kept group"),
		    // Model name
		    Renamed = Table.RenameColumns(#"Distinct groups", {{"category_group", "Category Group"}}),
		    // ELEC, FASH, … for compact labels
		    #"Group code" = Table.AddColumn(Renamed, "Group Code", each Text.Upper(Text.Start(Text.Remove([Category Group], {" ", ",", "&"}), 4)), type text)
		in
		    #"Group code"
	lineageTag: d265f438-cde5-5974-8359-83958a6b49cc

	annotation PBI_ResultType = Table

/// Plan rows whose group is not in the product mart (left anti join). Must stay empty; the pipeline runs the same check.
expression 'Plan Unknown Groups' =
		let
		    Source = Table.NestedJoin(#"Plan Raw", {"Category Group"}, #"Plan Groups", {"Category Group"}, "Match", JoinKind.LeftAnti)
		in
		    Source
	lineageTag: 2c9b2d02-ed67-527b-b2bc-ca7d66fe222c

	annotation PBI_ResultType = Table
