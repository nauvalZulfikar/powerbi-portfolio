	/// Average review of the seller-month rows (plain average of the monthly averages).
	measure 'Seller Monthly Avg Review' = AVERAGE ( 'Seller Monthly'[Monthly Avg Review] )
		formatString: 0.00
		displayFolder: Sellers
		lineageTag: 56c1d02a-0af7-5188-915f-5f9add82fadb

	/// Latitude of the seller's zip-prefix centroid (for the map).
	measure 'Seller Lat' = AVERAGE ( Seller[Lat] )
		formatString: 0.0000
		displayFolder: Sellers
		lineageTag: 91fdbe09-af4c-56f0-b5f5-f9e1d48bc93a

	/// Longitude of the seller's zip-prefix centroid (for the map).
	measure 'Seller Lng' = AVERAGE ( Seller[Lng] )
		formatString: 0.0000
