	/// Prior year on the Gregorian calendar (calendar-based time intelligence).
	measure 'Revenue PY (cal)' = CALCULATE ( [Revenue], DATEADD ( 'Gregorian', -1, YEAR ) )
		formatString: \R$ #,0
		displayFolder: Time Intelligence
		lineageTag: 267a1bfa-87d5-50c8-8648-5f34abeefd78

	/// Year to date on the Gregorian calendar.
	measure 'Revenue YTD (cal)' = CALCULATE ( [Revenue], DATESYTD ( 'Gregorian' ) )
		formatString: \R$ #,0
		displayFolder: Time Intelligence
		lineageTag: 9533a814-bfb6-5266-bd40-354f8f9c8d21

	/// Prior quarter on the Gregorian calendar; a Weekday Name filter is kept, not cleared.
	measure 'Revenue PQ (cal)' = CALCULATE ( [Revenue], DATEADD ( 'Gregorian', -1, QUARTER ) )
		formatString: \R$ #,0
		displayFolder: Time Intelligence
		lineageTag: 0f8ae62e-b127-5912-817d-39be76128ab1

	/// Distinct customers with an order item under the current filters: 'Order Items' as a filter carries its expanded table, so Product filters reach Customer.
	measure 'Customers Buying Category' = CALCULATE ( DISTINCTCOUNT ( Customer[Customer Unique Id] ), 'Order Items' )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 6d58c788-63be-58dc-aa85-f9f4520989a8

	/// Order-level review for the orders in context: TREATAS moves the item order ids onto Orders without a physical relationship.
	measure 'Seller Order Review' = CALCULATE ( [Avg Review], TREATAS ( VALUES ( 'Order Items'[Order Id] ), Orders[Order Id] ) )
		formatString: 0.00
		displayFolder: Satisfaction
		lineageTag: bebf78b4-f67b-525c-ac65-02c029e54fd9

	/// Revenue of the three best categories in the selection (TOPN over a temporary table).
	measure 'Top 3 Category Revenue' = SUMX ( TOPN ( 3, ADDCOLUMNS ( VALUES ( Product[Category] ), "@r", [Revenue] ), [@r] ), [@r] )
		formatString: \R$ #,0
		displayFolder: Sales
		lineageTag: c31de770-1fd8-5fd5-8b4e-d6f55bc9659b

	/// Previous month with OFFSET over the months in the selection (no date functions).
	measure 'Revenue PM (OFFSET)' = CALCULATE ( [Revenue], OFFSET ( -1, ALLSELECTED ( 'Date'[Year Month], 'Date'[Year Month Key] ), ORDERBY ( 'Date'[Year Month Key] ) ) )
		formatString: \R$ #,0
		displayFolder: Time Intelligence
		lineageTag: a1c13179-a34f-5294-b012-db1f1a111af0

	/// Running total from the first selected month (WINDOW 1 ABS to 0 REL).
	measure 'Revenue Running Total' = CALCULATE ( [Revenue], WINDOW ( 1, ABS, 0, REL, ALLSELECTED ( 'Date'[Year Month], 'Date'[Year Month Key] ), ORDERBY ( 'Date'[Year Month Key] ) ) )
		formatString: \R$ #,0
		displayFolder: Time Intelligence
		lineageTag: 08dd7b61-beb0-5ccb-94b7-33841866767a

	/// Average of this and the two previous months' revenue (WINDOW -2 REL to 0 REL).
	measure 'Revenue 3M MA (WINDOW)' = AVERAGEX ( WINDOW ( -2, REL, 0, REL, ALLSELECTED ( 'Date'[Year Month], 'Date'[Year Month Key] ), ORDERBY ( 'Date'[Year Month Key] ) ), [Revenue] )
		formatString: \R$ #,0
		displayFolder: Time Intelligence
		lineageTag: 50cc0bf0-0e3a-5a1a-96fb-fb4a71426c7a

	/// Dense revenue rank of a category within the selection.
	measure 'Category Rank' = IF ( ISINSCOPE ( Product[Category] ), RANK ( DENSE, ALLSELECTED ( Product[Category] ), ORDERBY ( [Revenue], DESC ) ) )
		formatString: #,0
		displayFolder: Sales
		lineageTag: d6011a9e-87ac-5a65-961a-f72536720abf

	/// Code of the highest-revenue seller in the state on the row (INDEX 1, PARTITIONBY state).
	measure 'Top Seller in State' =
			VAR _top =
			    INDEX ( 1,
			        ADDCOLUMNS ( ALLSELECTED ( Seller[State], Seller[Seller Code] ), "@rev", [Revenue] ),
			        ORDERBY ( [@rev], DESC ), PARTITIONBY ( Seller[State] ) )
			RETURN IF ( HASONEVALUE ( Seller[State] ), MAXX ( _top, Seller[Seller Code] ) )
		displayFolder: Sellers
		lineageTag: 8064c1b4-e86e-5ff4-bbd5-f0be2a82e28d

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Olist.YoY on Revenue: one function for every YoY.
	measure 'Revenue YoY % (fn)' = Olist.YoY ( [Revenue] )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: dd80f08a-42b2-5f98-bf5c-512fb4989316

	/// Olist.YoY on Order Count.
	measure 'Orders YoY % (fn)' = Olist.YoY ( [Order Count] )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 4cf00a00-030d-5d6b-99e6-aa8b55a494f3

	/// Olist.YoY on Customers.
	measure 'Customers YoY % (fn)' = Olist.YoY ( [Customers] )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 633ccedd-e9b1-5dc0-90e4-3692f4c8a96a

	/// SYNTHETIC plan (see README): filtered by Product and Date through many-to-many relationships.
	measure 'Plan Revenue' = SUM ( 'Category Plan'[Plan Revenue] )
		formatString: \R$ #,0
		displayFolder: Plan
		lineageTag: ccfe726b-9766-56bc-bc75-f448f75c3603

	/// Revenue above (+) or below (−) the synthetic plan.
	measure 'Revenue vs Plan %' = IF ( NOT ISBLANK ( [Plan Revenue] ), Olist.SafePct ( [Revenue] - [Plan Revenue], [Plan Revenue] ) )
		formatString: 0.0%
		displayFolder: Plan
		lineageTag: 3e2b8907-6b0f-5b44-80c7-753e6a396ab7

	/// Order review per seller through the Order Seller bridge: each order counts once per seller, not once per item.
	measure 'Seller Avg Review (order-level)' = CALCULATE ( [Avg Review], 'Order Seller' )
		formatString: 0.00
		displayFolder: Satisfaction
		lineageTag: dd3e4eb4-1ac5-500e-9b55-bb80201753c6

	/// Late rate of orders that ship from more than one seller.
	measure 'Multi-seller Late Rate %' = CALCULATE ( [Late Rate %], Orders[Seller Count] > 1 )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: d006fe36-6e15-5d24-98d5-2c50951c1598

	/// Late rate of orders from one seller, for comparison.
	measure 'Single-seller Late Rate %' = CALCULATE ( [Late Rate %], Orders[Seller Count] = 1 )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 4f1dc688-0870-57a3-a8ac-adadc9135385

	/// Customers whose lifetime value falls in the Spend Bands row.
	measure 'Customers in Spend Band' =
			VAR _lo = MIN ( 'Spend Bands'[Min Value] )
			VAR _hi = MAX ( 'Spend Bands'[Max Value] )
			RETURN
			    COUNTROWS ( FILTER ( Customer, Customer[Valid Orders] > 0
			        && Customer[Lifetime Value] >= _lo && Customer[Lifetime Value] < _hi ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 3ec2b446-5c3d-5f95-843c-0322aaabae62

	/// The measure picked in the Metric field parameter, with a format string that follows it (R$, count, %, stars).
	measure 'Metric Value' =
			SWITCH ( SELECTEDVALUE ( Metric[Metric Order], 0 ),
			    0, [Revenue],
			    1, [Order Count],
			    2, [AOV],
			    3, [Late Rate %],
			    4, [Avg Review] )
		displayFolder: Report UI
		lineageTag: 97da85f3-8cf3-5f55-9d0c-12b88437979e

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( Metric[Metric Order], 0 ), 0, "\R$ #,0", 1, "#,0", 2, "\R$ #,0.00", 3, "0.0%", 4, "0.00"" ★""" )

	/// Screen-reader text for the revenue card: the number and its year-over-year change, recomputed for every filter.
	measure 'Alt Text Revenue' =
			VAR _r = [Revenue]
			VAR _y = [Revenue YoY %]
			RETURN
			    "Revenue R$ " & FORMAT ( _r, "#,0" )
			        & IF ( ISBLANK ( _y ), ", no prior year in the selection", ", YoY " & FORMAT ( _y, "+0.0%;-0.0%" ) )
		displayFolder: Report UI
		lineageTag: beaee4c6-45fc-5b17-b03e-1f49276f68b3

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Late rate as a symbol and a word, so the status never depends on colour alone.
	measure 'Late Status' =
			VAR _r = [Late Rate %]
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( _r ), BLANK (),
			        _r >= 0.12, "▲ High",
			        _r >= 0.08, "● Watch",
			        "✓ OK" )
		displayFolder: Report UI
		lineageTag: ba9cade6-80d3-5b5c-a53b-110938d364fb

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Lane late rate as a symbol and a word (same thresholds as Late Status).
	measure 'Lane Late Status' =
			VAR _r = [Lane Late Rate %]
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( _r ), BLANK (),
			        _r >= 0.12, "▲ High",
			        _r >= 0.08, "● Watch",
			        "✓ OK" )
		displayFolder: Report UI
		lineageTag: 999179f1-190a-5824-b84c-c38b25e713f3

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Screen-reader text for the late-rate card.
	measure 'Alt Text Late Rate' = "Late rate " & FORMAT ( [Late Rate %], "0.0%" ) & ", " & [Late Status]
		displayFolder: Report UI
		lineageTag: 9e6b991a-9bb3-53fb-9764-235cddd51f65

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Revenue for the 12 months up to the last month with data, blank before: the sparkline on the category tooltip.
	measure 'Revenue (Last 12 Months)' =
			VAR _last = CALCULATE ( MAX ( 'Order Items'[Order Date] ), REMOVEFILTERS (), 'Order Items'[Is Valid] = TRUE () )
			VAR _m = MAX ( 'Date'[Month Start] )
			RETURN IF ( _m > EDATE ( _last, -12 ) && _m <= _last, [Revenue] )
		formatString: \R$ #,0
		displayFolder: Sales
		lineageTag: f71d3578-c73c-5539-926c-876163d9f847

	/// Customers whose revenue in the current filters (year, region, category ...) falls in the Spend Bands row.
	measure 'Customers in Band' =
			VAR _lo = MIN ( 'Spend Bands'[Min Value] )
			VAR _hi = MAX ( 'Spend Bands'[Max Value] )
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( Customer[Customer Unique Id] ), VAR _r = [Revenue per Customer] RETURN NOT ISBLANK ( _r ) && _r >= _lo && _r < _hi ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 9dea8667-8a8b-597b-ab62-eb3a29248a70

	/// Revenue of the customers in the Spend Bands row (same rule as Customers in Band).
	measure 'Revenue in Band' =
			VAR _lo = MIN ( 'Spend Bands'[Min Value] )
			VAR _hi = MAX ( 'Spend Bands'[Max Value] )
			RETURN
			    SUMX ( FILTER ( VALUES ( Customer[Customer Unique Id] ), VAR _r = [Revenue per Customer] RETURN NOT ISBLANK ( _r ) && _r >= _lo && _r < _hi ), [Revenue] )
		formatString: \R$ #,0
		displayFolder: Customers
		lineageTag: 50c0c9c0-940c-5285-8219-295eb2a2e08d

	/// Customers with a valid order whose last purchase is 180+ days before the end of the data.
	measure 'Churned Customers' = COUNTROWS ( FILTER ( Customer, Customer[Valid Orders] > 0 && Customer[Recency Days] >= 180 ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 81831c9d-3b1e-5f63-9698-09652856cd91

	/// Last purchase 90–179 days before the end of the data: not churned yet.
	measure 'At-Risk Customers (90–180d)' = COUNTROWS ( FILTER ( Customer, Customer[Valid Orders] > 0 && Customer[Recency Days] >= 90 && Customer[Recency Days] < 180 ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 978d4cf0-cf37-57b1-becf-24ba7808752e

	/// Churned customers ÷ customers with a valid order.
	measure 'Churn Rate %' = Olist.SafePct ( [Churned Customers], COUNTROWS ( FILTER ( Customer, Customer[Valid Orders] > 0 ) ) )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: d2a466fd-9a95-5d83-9965-22fb5c6118ac

	/// Expected item revenue in the next 12 months (BG/NBD × Gamma-Gamma), summed over customers.
	measure 'Predicted CLV' = SUM ( Customer[Predicted CLV 12M] )
		formatString: \R$ #,0
		displayFolder: Customers
		lineageTag: 3b23c8bc-ca7c-5dc2-b8ce-a0aa7c314718

	/// Predicted CLV per customer with a valid order.
	measure 'Avg Predicted CLV' = AVERAGEX ( FILTER ( Customer, Customer[Valid Orders] > 0 ), Customer[Predicted CLV 12M] )
		formatString: \R$ #,0.00
		displayFolder: Customers
		lineageTag: 4b446337-2a8e-5da3-b962-4cc3dd3bb6f9

	/// A/B/C tier recomputed on the current selection (A = top 50% of revenue, B = next 30%, C = rest). Pareto Tier is the lifetime version.
	measure 'Seller ABC (dynamic)' =
			VAR _rev = [Revenue]
			VAR _tbl = ADDCOLUMNS ( ALLSELECTED ( Seller[Seller Code] ), "@rev", [Revenue] )
			VAR _total = SUMX ( _tbl, [@rev] )
			VAR _cum =
			    SUMX (
			        WINDOW ( 1, ABS, 0, REL, _tbl, ORDERBY ( [@rev], DESC, Seller[Seller Code], ASC ), DEFAULT, , MATCHBY ( Seller[Seller Code] ) ),
			        [@rev] )
			VAR _share = DIVIDE ( _cum, _total )
			RETURN
			    IF ( HASONEVALUE ( Seller[Seller Code] ) && NOT ISBLANK ( _rev ),
			        SWITCH ( TRUE (), _share <= 0.5, "A", _share <= 0.8, "B", "C" ) )
		displayFolder: Sellers
		lineageTag: 32915acc-b247-5233-8a29-d8b9a8569a00

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Revenue rank of the seller among the sellers in the selection.
	measure 'Seller Rank (selection)' =
			IF ( HASONEVALUE ( Seller[Seller Code] ) && NOT ISBLANK ( [Revenue] ),
			    RANK ( SKIP, ADDCOLUMNS ( ALLSELECTED ( Seller[Seller Code] ), "@rev", [Revenue] ), ORDERBY ( [@rev], DESC ), DEFAULT, , MATCHBY ( Seller[Seller Code] ) ) )
		formatString: #,0
		displayFolder: Sellers
		lineageTag: 285b5b82-fd8b-5b72-826d-a4cff9885e20

	/// 90th percentile of seller revenue in the selection: the reference line on the seller scatter.
	measure 'Seller Revenue P90' = PERCENTILEX.INC ( FILTER ( ALLSELECTED ( Seller[Seller Code] ), NOT ISBLANK ( [Revenue] ) ), [Revenue], 0.9 )
		formatString: \R$ #,0
		displayFolder: Sellers
		lineageTag: 60fd2c95-6099-5b31-b890-6d64693c3469

	/// Sellers moving from the 2017 tier (row) to the 2018 tier (column), Jan–Aug both years.
	measure 'Transition Sellers' = SUM ( 'Seller Tier Transition'[Sellers] )
		formatString: #,0
		displayFolder: Sellers
		lineageTag: 8fa1c981-21d5-5da4-b5ac-62f742e454d9

	/// Share of the 2017 tier (row) that ended in each 2018 tier.
	measure 'Transition Share %' = Olist.SafePct ( [Transition Sellers], CALCULATE ( [Transition Sellers], REMOVEFILTERS ( 'Seller Tier Transition'[Tier 2018] ) ) )
		formatString: 0.0%
		displayFolder: Sellers
		lineageTag: 5297dc52-01a0-507e-aaf2-8326e033f79d

	/// Orders that reached the Funnel Stage row: all orders, so it lifts the valid-only report filter and the delivered-only page filter.
	measure 'Funnel Orders' =
			VAR _s = SELECTEDVALUE ( 'Funnel Stage'[Stage Order] )
			VAR _purchased = CALCULATE ( COUNTROWS ( Orders ), REMOVEFILTERS ( Orders[Is Valid], Orders[Is Delivered] ) )
			RETURN
			    SWITCH ( _s,
			        1, _purchased,
			        2, CALCULATE ( COUNTROWS ( Orders ), REMOVEFILTERS ( Orders[Is Valid], Orders[Is Delivered] ), NOT ISBLANK ( Orders[Approval Hours] ) ),
			        3, CALCULATE ( COUNTROWS ( Orders ), REMOVEFILTERS ( Orders[Is Valid], Orders[Is Delivered] ), NOT ISBLANK ( Orders[Approval Hours] ), NOT ISBLANK ( Orders[Days To Carrier] ) ),
			        4, CALCULATE ( COUNTROWS ( Orders ), REMOVEFILTERS ( Orders[Is Valid], Orders[Is Delivered] ), NOT ISBLANK ( Orders[Approval Hours] ), NOT ISBLANK ( Orders[Days To Carrier] ), Orders[Is Delivered] = TRUE () ),
			        5, CALCULATE ( COUNTROWS ( Orders ), REMOVEFILTERS ( Orders[Is Valid], Orders[Is Delivered] ), NOT ISBLANK ( Orders[Approval Hours] ), NOT ISBLANK ( Orders[Days To Carrier] ), Orders[Is Delivered] = TRUE (), NOT ISBLANK ( Orders[Review Score] ) ) )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: b88d5b81-486e-54ba-8f96-b5b3f9d004c8

	/// Orders at this stage ÷ orders purchased.
	measure 'Funnel Conversion %' = Olist.SafePct ( [Funnel Orders], CALCULATE ( [Funnel Orders], 'Funnel Stage'[Stage Order] = 1 ) )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: c0e263a3-9439-58cf-b2b2-83f5eed75b85

	/// 9 in 10 delivered orders arrive within this many days (PERCENTILEX.INC).
	measure 'Delivery Days P90' = PERCENTILEX.INC ( FILTER ( Orders, Orders[Is Delivered] = TRUE () && NOT ISBLANK ( Orders[Delivery Days] ) ), Orders[Delivery Days], 0.9 )
		formatString: #,0.0
		displayFolder: Delivery
		lineageTag: 0521358f-2d26-5dd8-9f7c-8b2c307aad2c

	/// Delivery Days P90 of the lane's customer state (all lanes into that state).
	measure 'Lane State P90' = CALCULATE ( [Delivery Days P90], TREATAS ( VALUES ( 'Freight Lanes'[Customer State] ), Customer[State] ), REMOVEFILTERS ( 'Freight Lanes' ) )
		formatString: #,0.0
		displayFolder: Logistics
		lineageTag: 7b626a04-034e-55f5-a936-cd84ad5720b2

	/// ▲ when the lane's average delivery time is above its customer state's P90 (an outlier lane).
	measure 'Lane Outlier' =
			VAR _d = [Lane Avg Delivery Days]
			VAR _p = [Lane State P90]
			RETURN IF ( HASONEVALUE ( 'Freight Lanes'[Lane] ), IF ( _d > _p, "▲ Above state P90", "–" ) )
		displayFolder: Logistics
		lineageTag: ebc39f7a-9e53-504c-897d-cb5a1e97ffb5

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Red for outlier lanes (conditional formatting).
	measure 'Lane Outlier Color' = IF ( [Lane Avg Delivery Days] > [Lane State P90], "#D03B3B", "#52514E" )
		displayFolder: Logistics
		lineageTag: 036b8c39-ce61-55d4-9eaa-5e6f8defbb6f

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["PROVIDE_FORMAT_STRING_FOR_MEASURES","INTEGER_FORMATTING"]}

	/// Revenue minus the same period last year (like-for-like months, see Revenue PY).
	measure 'Revenue YoY Δ' =
			VAR _py = [Revenue PY]
			RETURN IF ( NOT ISBLANK ( _py ), [Revenue] - _py )
		formatString: \R$ #,0
		displayFolder: Time Intelligence
		lineageTag: 306f08de-c08f-518e-ab60-607b876eb815

	/// ETS forecast of monthly revenue, Sep–Dec 2018 (src/predict.py).
	measure 'Forecast Revenue' = SUM ( 'Revenue Forecast'[Forecast Revenue] )
		formatString: \R$ #,0
		displayFolder: Sales
		lineageTag: c9b7c0fb-74b3-502d-aa8e-5cc5fb5484fe

	/// 80% prediction interval, lower bound.
	measure 'Forecast Lower 80' = SUM ( 'Revenue Forecast'[Lower 80] )
		formatString: \R$ #,0
		displayFolder: Sales
		lineageTag: 457b3180-7a91-543f-bc41-3cea3d553a2f

	/// 80% prediction interval, upper bound.
	measure 'Forecast Upper 80' = SUM ( 'Revenue Forecast'[Upper 80] )
		formatString: \R$ #,0
		displayFolder: Sales
		lineageTag: 20d1fe8b-d747-5011-95ad-3c534d9b3dc3

	/// Revenue up to Aug 2018, blank after: the actual line next to the forecast.
	measure 'Revenue Actual (to Aug 2018)' = IF ( MAX ( 'Date'[Month Start] ) <= DATE ( 2018, 8, 1 ) && MIN ( 'Date'[Month Start] ) >= DATE ( 2017, 1, 1 ), [Revenue] )
		formatString: \R$ #,0
		displayFolder: Sales
		lineageTag: 2814119e-a5d2-5ff6-af61-0864439c7f38

	/// The what-if slider: percentage points taken off the late rate.
	measure 'Late Reduction (pp) Value' = SELECTEDVALUE ( 'Late Reduction (pp)'[Late Reduction (pp)], 0 )
		formatString: 0
		displayFolder: Delivery
		lineageTag: ca8f6251-6330-5273-b5a3-bc9dfecc5df1

	/// Late rate after the what-if reduction (never below 0).
	measure 'Projected Late Rate %' = MAX ( 0, [Late Rate %] - [Late Reduction (pp) Value] / 100 )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 0008b1d0-86f2-54e1-9a4d-672951de4829

	/// Bad review share if the late rate fell by the slider: on-time bad-review rate, late odds × 8.97 (logit in src/analysis.py).
	measure 'Projected Bad Review %' =
			VAR _or = 8.97  -- odds ratio of late delivery in the bad-review logit (src/analysis.py)
			VAR _pOn = CALCULATE ( [Bad Review %], Orders[Is Late] = FALSE () )
			VAR _oddsLate = Olist.SafePct ( _pOn, 1 - _pOn ) * _or
			VAR _pLate = Olist.SafePct ( _oddsLate, 1 + _oddsLate )
			VAR _moved = [Late Rate %] - [Projected Late Rate %]
			RETURN IF ( NOT ISBLANK ( [Bad Review %] ), [Bad Review %] - _moved * ( _pLate - _pOn ) )
		formatString: 0.0%
		displayFolder: Satisfaction
		lineageTag: 0dbc08d1-4e14-5fec-bc30-38914783ee22

	/// Projected minus actual bad review share.
	measure 'Bad Review Δ (what-if)' = [Projected Bad Review %] - [Bad Review %]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Satisfaction
		lineageTag: c14e6740-ffeb-5f55-b91d-4d282c8f046e

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 960b13c0-db09-52de-83d9-d35f9661d17a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = {1}
