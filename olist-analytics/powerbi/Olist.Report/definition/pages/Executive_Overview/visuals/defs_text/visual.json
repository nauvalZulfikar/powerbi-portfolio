    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Definitions",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Revenue — Item price of valid orders (not cancelled / unavailable). Freight is separate; GMV = revenue + freight.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Late — Delivered after the estimated date the customer was promised. Late rate = late ÷ delivered orders.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Late status — ▲ High ≥ 12% · ● Watch ≥ 8% · ✓ OK — the icon and the word carry the status, colour only repeats it.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Customer — A person (customer_unique_id), not an order-level customer_id: one person can hold many ids.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "RFM — Recency, frequency, monetary quintile scores per customer, mapped to segments (Champions, At risk ...).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Seller code — Short public code (S0001 ...). Seller ids, customer ids and names never appear in a visual.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#52514E"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
