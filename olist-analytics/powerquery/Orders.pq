let
    Source = Parquet.Document(File.Contents(DataFolder & "fact_orders.parquet")),
    // Leave out purchased_at (see README, performance)
    #"Kept columns" = Table.SelectColumns(Source, {"order_id", "customer_unique_id", "order_date", "delivered_date", "estimated_date", "order_hour", "order_status", "is_valid", "is_delivered", "customer_order_seq", "customer_state", "item_count", "seller_count", "items_value", "freight_value", "paid_value", "main_payment_type", "installments", "used_multiple_methods", "approval_hours", "days_to_carrier", "delivery_days", "promised_days", "delay_days", "is_late", "delivery_bucket", "delivery_bucket_order", "review_score", "review_label", "has_comment", "review_answer_days"}),
    Typed = Table.TransformColumnTypes(#"Kept columns", {{"order_id", type text}, {"customer_unique_id", type text}, {"order_date", type date}, {"delivered_date", type date}, {"estimated_date", type date}, {"order_hour", Int64.Type}, {"order_status", type text}, {"is_valid", type logical}, {"is_delivered", type logical}, {"customer_order_seq", Int64.Type}, {"customer_state", type text}, {"item_count", Int64.Type}, {"seller_count", Int64.Type}, {"items_value", type number}, {"freight_value", type number}, {"paid_value", type number}, {"main_payment_type", type text}, {"installments", Int64.Type}, {"used_multiple_methods", type logical}, {"approval_hours", type number}, {"days_to_carrier", type number}, {"delivery_days", type number}, {"promised_days", Int64.Type}, {"delay_days", Int64.Type}, {"is_late", type logical}, {"delivery_bucket", type text}, {"delivery_bucket_order", Int64.Type}, {"review_score", Int64.Type}, {"review_label", type text}, {"has_comment", type logical}, {"review_answer_days", type number}})
in
    Typed
