<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Olist">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, 929d0ec0-7a41-4b1e-bc7c-b754a28bddcc";Initial Catalog=sobe_wowvirtualserver-DATASET_ID_SET_AT_PUBLISH;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Scorecard"><Query><DataSourceName>Olist</DataSourceName><CommandText>EVALUATE
SUMMARIZECOLUMNS (
    Seller[Seller Code], Seller[State], Seller[Pareto Tier], 'Date'[Year Month Key], 'Date'[Year Month],
    "Revenue", [Revenue], "Orders", [Order Count], "Avg Review", [Item Avg Review], "Late Rate", [Seller Late Rate %]
)
ORDER BY Seller[Seller Code], 'Date'[Year Month Key]</CommandText></Query><Fields><Field Name="Seller_Code"><DataField>[Seller Code]</DataField></Field><Field Name="State"><DataField>[State]</DataField></Field><Field Name="Pareto_Tier"><DataField>[Pareto Tier]</DataField></Field><Field Name="Year_Month_Key"><DataField>[Year Month Key]</DataField></Field><Field Name="Year_Month"><DataField>[Year Month]</DataField></Field><Field Name="Revenue"><DataField>[Revenue]</DataField></Field><Field Name="Orders"><DataField>[Orders]</DataField></Field><Field Name="Avg_Review"><DataField>[Avg Review]</DataField></Field><Field Name="Late_Rate"><DataField>[Late Rate]</DataField></Field></Fields><Filters><Filter><FilterExpression>=Fields!Seller_Code.Value</FilterExpression><Operator>In</Operator><FilterValues><FilterValue>=Parameters!SellerCode.Value</FilterValue></FilterValues></Filter></Filters></DataSet>
    <DataSet Name="SellerList"><Query><DataSourceName>Olist</DataSourceName><CommandText>EVALUATE
SELECTCOLUMNS ( FILTER ( ADDCOLUMNS ( VALUES ( Seller[Seller Code] ), "R", [Revenue] ), NOT ISBLANK ( [R] ) ),
    "Seller Code", Seller[Seller Code], "Revenue", [R] )
ORDER BY [Revenue] DESC</CommandText></Query><Fields><Field Name="Seller_Code"><DataField>[Seller Code]</DataField></Field><Field Name="Revenue"><DataField>[Revenue]</DataField></Field></Fields></DataSet>
    <DataSet Name="TopSellers"><Query><DataSourceName>Olist</DataSourceName><CommandText>EVALUATE
SELECTCOLUMNS ( TOPN ( 10, ADDCOLUMNS ( VALUES ( Seller[Seller Code] ), "R", [Revenue] ), [R], DESC ),
    "Seller Code", Seller[Seller Code] )</CommandText></Query><Fields><Field Name="Seller_Code"><DataField>[Seller Code]</DataField></Field></Fields></DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="SellerCode">
      <DataType>String</DataType>
      <Prompt>Seller code</Prompt>
      <MultiValue>true</MultiValue>
      <DefaultValue><DataSetReference><DataSetName>TopSellers</DataSetName><ValueField>Seller_Code</ValueField></DataSetReference></DefaultValue>
      <ValidValues><DataSetReference><DataSetName>SellerList</DataSetName><ValueField>Seller_Code</ValueField><LabelField>Seller_Code</LabelField></DataSetReference></ValidValues>
    </ReportParameter>
  </ReportParameters>
